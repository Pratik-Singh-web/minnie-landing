---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Marquee from "../components/Marquee.astro";
import Hero from "../sections/Hero.astro";
import Benefits from "../sections/Benefits.astro";
import Demo from "../sections/Demo.astro";
import Trust from "../sections/Trust.astro";
import Privacy from "../sections/Privacy.astro";
import Customize from "../sections/Customize.astro";
import MCP from "../sections/MCP.astro";
import Comparison from "../sections/Comparison.astro";
import FAQ from "../sections/FAQ.astro";
import FinalCTA from "../sections/FinalCTA.astro";
import Footer from "../components/Footer.astro";

const tools = [
  "Bash",
  "Read",
  "Edit",
  "Write",
  "Grep",
  '"I want to run pytest. Ok?"',
  "MCP · GitHub",
  "MCP · Notion",
];

const promises = [
  "Deny is a hug, not a scold",
  "Zero extra AI cost",
  "Runs on your Mac",
  "On-device voice",
];
---

<Layout>
  <!-- Sticky nav + reading-progress bar -->
  <Navbar />

  <main id="top">
    <!-- Hero: headline, waitlist, and the pet who watches your cursor -->
    <Hero />

    <!-- Tools she can reach, scrolling past -->
    <Marquee items={tools} />

    <!-- 3 core benefit cards + bring-your-own-agent strip -->
    <Benefits />

    <!-- Live playground: type at her, she picks tools and asks permission -->
    <Demo />

    <!-- The consent layer: permission cloud + trust modes -->
    <Trust />

    <!-- Local & private: on-device voice, local CLI, no telemetry -->
    <Privacy />

    <!-- Species / personality / name previewer -->
    <Customize />

    <!-- Connect your tools: MCP catalog & Google OAuth -->
    <MCP />

    <!-- Minnie vs web chatbot vs bare CLI agent -->
    <Comparison />


    <!-- Accordion FAQ -->
    <FAQ />

    <!-- The promises, scrolling the other way -->
    <Marquee
      items={promises}
      sep="✦"
      background="var(--pink)"
      color="#101a12"
      reverse
      display
    />

    <!-- Last call for the waitlist -->
    <FinalCTA />
  </main>

  <Footer />
</Layout>
