---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../sections/Hero.astro";
import Talk from "../sections/Talk.astro";
import Consent from "../sections/Consent.astro";
import Stack from "../sections/Stack.astro";
import Moods from "../sections/Moods.astro";
import Pets from "../sections/Pets.astro";
import Behavior from "../sections/Behavior.astro";
import Local from "../sections/Local.astro";
import Pricing from "../sections/Pricing.astro";
import FAQ from "../sections/FAQ.astro";
import Roadmap from "../sections/Roadmap.astro";
import FinalCTA from "../sections/FinalCTA.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <Navbar />

  <main id="top">
    <!-- Headline left, the pet right -->
    <Hero />

    <!-- Talk to her: the request card and her states -->
    <Talk />

    <!-- The ink panel: the consent moat -->
    <Consent />

    <!-- Bring your own agent + MCP tools, as two cards -->
    <Stack />

    <!-- Orange band -->
    <Moods />

    <!-- The four species -->
    <Pets />

    <!-- State graph you can click through -->
    <Behavior />

    <!-- Local & private -->
    <Local />

    <!-- What it costs. Required on the site by Dodo's verification checklist, and
         it has to match what Dodo is told: the core is free, and characters are
         one-time purchases that do not exist yet. -->
    <Pricing />

    <FAQ />

    <!-- Today / Next -->
    <Roadmap />

    <!-- Closing ink panel -->
    <FinalCTA />
  </main>

  <Footer />
</Layout>
