---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { contactEmail, updated, refundDays } from "../legal";
import { pageLd } from "../site";

const base = import.meta.env.BASE_URL;
const site = Astro.site?.href ?? "https://heyminnie.com/";

const h2 = "prose-h2";
const p = "prose-p";
const ul = "prose-ul";
const link = "prose-a";
---

<Layout
  title="Refund & Cancellation Policy — Minnie"
  description="Minnie is free for life. For optional one-time purchases: a full refund within thirty days, no reason needed, and nothing to cancel."
  jsonLd={[pageLd({ url: new URL("refund/", site).href, name: "Refund & Cancellation Policy", description: "Minnie is free for life. For optional one-time purchases: a full refund within thirty days, no reason needed, and nothing to cancel.", site, type: "WebPage" })]}
  breadcrumbs={[{ name: "Refunds", href: `${base}refund/` }]}
>
  <Navbar />

  <main class="legal">
    <a href={base} class="legal__back mono">← back to home</a>

    <h1 class="legal__h1">Refund &amp; Cancellation Policy</h1>
    <p class="legal__date mono">Last updated: {updated}</p>

    <p class={p} style="margin-top:28px;">
      <strong>Minnie is free for life</strong>, so most people will never pay us
      anything. This policy covers the optional one-time purchases we may offer, such
      as extra characters. If you buy one and it does not fit, we would rather give the
      money back than keep it.
    </p>

    <h2 class={h2}>Refunds</h2>
    <p class={p}>
      <strong>Within {refundDays} days of a purchase, you can have a full refund, and
      you do not have to give a reason.</strong> Email <a class={link} href={`mailto:${contactEmail}`}>{contactEmail}</a> from the address you
      bought with, and we will process it.
    </p>
    <p class={p}>
      Refunds go back to the original payment method. Once processed on our side, your
      bank usually takes another 5–10 working days to show it — that part is not
      something we can speed up.
    </p>
    <p class={p}>
      After {refundDays} days a purchase is final. If something has gone genuinely wrong —
      a double charge, or a purchase that never worked on your Mac — write to us
      regardless of the date. Those are mistakes, not refund requests, and we fix them.
    </p>

    <h2 class={h2}>Cancelling</h2>
    <p class={p}>
      There is nothing to cancel. Minnie has no subscription and no trial, and nothing
      you buy renews or charges you again.
    </p>

    <h2 class={h2}>What happens after a refund</h2>
    <p class={p}>
      The refunded purchase is removed. Minnie herself, and everything that is free,
      keeps working exactly as before — and everything on your Mac, from her memory of
      you to your settings, stays where it is.
    </p>

    <h2 class={h2}>Chargebacks</h2>
    <p class={p}>
      Please email us before raising a chargeback. A bank dispute takes months and
      locks the account while it runs; we can usually refund you the same day. We have
      never refused a request made in good faith.
    </p>

    <h2 class={h2}>Contact</h2>
    <p class={p}>
      <a class={link} href={`mailto:${contactEmail}`}>{contactEmail}</a>. Include the
      email you paid with and we will find the rest.
    </p>
    <p class={p}>
      See also the <a class={link} href={`${base}terms/`}>Terms of Service</a> and the <a class={link} href={`${base}privacy/`}>Privacy Policy</a>.
    </p>
  </main>

  <Footer />
</Layout>
