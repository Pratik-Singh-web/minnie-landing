---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import { tagSlug } from "../../site";

const base = import.meta.env.BASE_URL;
const site = Astro.site?.href ?? "https://heyminnie.com/";

const posts = (
  await getCollection("blog", ({ data }) => import.meta.env.DEV || !data.draft)
).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

// Topics with a hub page, commonest first. The index is the only page that
// links to every hub, so without this row the hubs are reachable only from
// whichever posts happen to carry the tag.
const tagCount = new Map<string, number>();
for (const post of posts)
  for (const t of post.data.tags) tagCount.set(t, (tagCount.get(t) ?? 0) + 1);

const topics = [...tagCount.entries()]
  .filter(([, n]) => n >= 2)
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([label, n]) => ({ label, n, href: `${base}blog/tags/${tagSlug(label)}/` }));

const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });

// A Blog node, not the app — same reasoning as BlogPost.astro.
const blogLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "The Minnie blog",
  url: new URL(`${base}blog/`, site).href,
  blogPost: posts.map((post) => ({
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    url: new URL(`${base}blog/${post.id}/`, site).href,
  })),
};
---

<Layout
  title="The Minnie blog — running an AI coding agent on your Mac"
  description="Notes on running an AI coding agent on your Mac: voice control, permissions, MCP servers, and what building a desktop pet for Claude Code actually taught us."
  jsonLd={[blogLd]}
  ogImagePath="og/blog.png"
  breadcrumbs={[{ name: "Blog", href: `${base}blog/` }]}
>
  <Navbar />

  <main class="legal">
    <a href={base} class="legal__back mono">← back to home</a>

    <h1 class="legal__h1">Blog</h1>
    <p class="legal__date mono">Notes from building Minnie</p>

    {topics.length > 0 && (
      <nav class="topics" aria-label="Browse by topic">
        {topics.map((t) => (
          <a class="topics__pill mono" href={t.href}>{t.label} <span>{t.n}</span></a>
        ))}
      </nav>
    )}

    {
      posts.length === 0 ? (
        <p class="prose-p" style="margin-top:28px;">Nothing published yet.</p>
      ) : (
        <ul class="postlist">
          {posts.map((post) => (
            <li class="postlist__item">
              <a class="postlist__link" href={`${base}blog/${post.id}/`}>
                <span class="postlist__date mono">{fmt(post.data.pubDate)}</span>
                <h2 class="postlist__title">{post.data.title}</h2>
                <p class="postlist__desc">{post.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </main>

  <Footer />
</Layout>

<style>
  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 22px;
  }
  .topics__pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 11px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 12px;
    text-decoration: none;
    color: var(--ink);
    background: var(--card, transparent);
  }
  .topics__pill:hover { border-color: var(--accent); background: var(--accent-t); }
  .topics__pill span { opacity: 0.5; }
</style>
