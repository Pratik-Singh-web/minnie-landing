---
import { getCollection, render } from "astro:content";
import BlogPost from "../../layouts/BlogPost.astro";
import { tagSlug } from "../../site";

export async function getStaticPaths() {
  // Drafts stay visible on `astro dev` and vanish from the production build,
  // so they never reach the sitemap.
  const posts = await getCollection(
    "blog",
    ({ data }) => import.meta.env.DEV || !data.draft
  );

  const base = import.meta.env.BASE_URL;

  // Which tags earned a hub page. src/pages/blog/tags/[tag].astro only builds a
  // hub once a tag has two or more posts, so linking every tag blindly would
  // point some posts at a 404. Count here and hand the layout a href only where
  // one exists.
  const tagCount = new Map<string, number>();
  for (const p of posts)
    for (const t of p.data.tags) tagCount.set(t, (tagCount.get(t) ?? 0) + 1);

  const tagLinks = (post: (typeof posts)[number]) =>
    post.data.tags.map((t) => ({
      label: t,
      href: (tagCount.get(t) ?? 0) >= 2 ? `${base}blog/tags/${tagSlug(t)}/` : undefined,
    }));

  // Two sibling links per post, ranked by shared tags and then by recency.
  // Without this, four of the nine posts were dead ends: the only way from one
  // to another was back out through /blog/, so crawl depth and the link graph
  // both stopped at the index.
  const related = (post: (typeof posts)[number]) =>
    posts
      .filter((p) => p.id !== post.id)
      .map((p) => ({
        p,
        shared: p.data.tags.filter((t) => post.data.tags.includes(t)).length,
      }))
      .sort(
        (a, b) =>
          b.shared - a.shared || b.p.data.pubDate.getTime() - a.p.data.pubDate.getTime()
      )
      .slice(0, 2)
      .map(({ p }) => ({
        href: `${base}blog/${p.id}/`,
        title: p.data.title,
        description: p.data.description,
      }));

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, related: related(post), tagLinks: tagLinks(post), ogImagePath: `og/${post.id}.png` },
  }));
}

const { post, related, tagLinks, ogImagePath } = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} related={related} tagLinks={tagLinks} ogImagePath={ogImagePath}>
  <Content />
</BlogPost>
