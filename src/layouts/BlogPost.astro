---
import Layout from "./Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  /** Siblings to link at the foot of the post. Chosen in [...slug].astro by
   *  shared tags, because most posts carried no link to another post and the
   *  blog index was the only path between them. */
  related?: { href: string; title: string; description: string }[];
  /** Tags with a hub page to point at. A tag used by only one post has no hub,
   *  so its `href` is undefined and it renders as plain text. */
  tagLinks?: { label: string; href?: string }[];
  /** This post's generated social card, as a path from the site root. */
  ogImagePath: string;
  /** This post's generated hero image (src/hero.ts), as a path from the site root. */
  heroImagePath: string;
}

const { title, description, pubDate, updatedDate, tags = [], related = [], tagLinks = [], ogImagePath, heroImagePath } = Astro.props;

const base = import.meta.env.BASE_URL;
const site = Astro.site?.href ?? "https://heyminnie.com/";
const url = new URL(Astro.url.pathname, site).href;

// No " — Minnie" suffix. The name is drowned out by Minnie Mouse, so it earns
// no clicks from searchers, and it spends title width Google could show the
// headline in. The brand still reaches results through og:site_name and JSON-LD.
const pageTitle = title;

// The pitch at the foot of every post. Posts used to end on "Keep reading" with
// no way to the app, so search visitors who liked a post had nowhere to go.
// Pet posts pull people who want a pet, coding posts people who use an agent,
// and each hears the half of Minnie that matches what they came for. Claims
// stay inside what the site already says (agents, Claude-only approvals,
// Apple Silicon, free).
// MCP posts carry ~40% of the site's search impressions (TASKS R9), so they get
// their own pitch: the connections Minnie sets up for you. Those reach the
// Claude Code brain only, so the line says so.
const isPetPost = tags.includes("desktop pet") && !tags.includes("claude code");
const isMcpPost = tags.includes("mcp");
const cta = isPetPost
  ? {
      h: "A desktop pet that also does work",
      p: "Minnie lives on your Mac like Shimeji or Bongo Cat. Ask her out loud and she runs Claude Code, Codex or Gemini CLI for you.",
    }
  : isMcpPost
  ? {
      h: "Your MCP servers, without the JSON",
      p: "Minnie connects Notion, Linear, GitHub and more in one click, then you just ask out loud. Works with Claude Code.",
    }
  : {
      h: "Skip the terminal window",
      p: "Minnie is a desktop pet that runs Claude Code, Codex or Gemini CLI for you. Talk to her out loud, and approve Claude Code's commands with a click.",
    };

const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });

// BlogPosting replaces the site-wide SoftwareApplication + FAQPage. Google reads
// datePublished/dateModified to judge freshness, which is most of the value here
// — the article rich result itself is limited to news publishers.
const postLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  ...(tags.length ? { keywords: tags.join(", ") } : {}),
  inLanguage: "en",
  author: { "@type": "Person", name: "Pratik Singh", url: "https://x.com/Sym6ol_" },
  publisher: {
    "@type": "Organization",
    name: "Minnie",
    url: site,
    logo: new URL(`${base}icon-512x512.png`, site).href,
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": url },
  // The 16:9 hero first: Google picks from this list for Discover and article
  // thumbnails, and prefers images at least 1200px wide. The OG card stays as
  // the second option.
  image: [new URL(`${base}${heroImagePath}`, site).href, new URL(`${base}${ogImagePath}`, site).href],
  isPartOf: { "@type": "Blog", name: "The Minnie blog", url: new URL(`${base}blog/`, site).href },
};
---

<Layout
  title={pageTitle}
  description={description}
  jsonLd={[postLd]}
  ogImagePath={ogImagePath}
  ogType="article"
  article={{ published: pubDate, modified: updatedDate, tags }}
  breadcrumbs={[
    { name: "Blog", href: `${base}blog/` },
    { name: title, href: Astro.url.pathname },
  ]}
>
  <Navbar />

  <main class="legal">
    <a href={`${base}blog/`} class="legal__back mono">← all posts</a>

    <h1 class="legal__h1">{title}</h1>
    <p class="legal__date mono">
      {fmt(pubDate)}
      {updatedDate ? ` · updated ${fmt(updatedDate)}` : ""}
      {tagLinks.map((t) => (
        <>
          {" · "}
          {t.href ? <a class="post__tag" href={t.href}>{t.label}</a> : t.label}
        </>
      ))}
    </p>

    <!-- The hero is the LCP element on every post, so it loads eagerly with
         high priority, and its intrinsic size is set so the text below it
         never jumps when it arrives. The alt is empty: the image illustrates
         the title directly above it and says nothing the title doesn't. -->
    <img
      class="post__hero"
      src={`${base}${heroImagePath}`}
      width="1600"
      height="900"
      alt=""
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />

    <div class="post__body">
      <slot />
    </div>

    <aside class="post__cta">
      <img src={`${base}minnie/still-curious.webp`} width="72" height="72" alt="" loading="lazy" decoding="async" />
      <div>
        <h2 class="post__cta-h">{cta.h}</h2>
        <p class="post__cta-p">{cta.p}</p>
        <a href={`${base}download/`} class="btn btn--sm">Download Minnie, free →</a>
        <span class="post__cta-meta mono">Apple Silicon · macOS 14+ · uses the AI plan you already have</span>
      </div>
    </aside>

    {related.length > 0 && (
      <aside class="post__related">
        <h2 class="post__related-h">Keep reading</h2>
        <ul class="post__related-list">
          {related.map((r) => (
            <li>
              <a href={r.href}>{r.title}</a>
              <span>{r.description}</span>
            </li>
          ))}
        </ul>
      </aside>
    )}
  </main>

  <Footer />
</Layout>

<style>
  .post__hero {
    display: block;
    width: 100%;
    height: auto;
    margin: 8px 0 40px;
    border-radius: 18px;
    border: 3px solid var(--ink);
    background: #2e1b12;
  }
  .post__tag {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
  }
  .post__tag:hover { background: var(--accent-t); }
  .post__cta {
    margin-top: 56px;
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 20px;
    align-items: start;
    padding: 24px;
    border: 3px solid var(--ink);
    border-radius: 18px;
    background: var(--card);
  }
  .post__cta-h {
    margin: 0;
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .post__cta-p {
    margin: 8px 0 18px;
    font-size: 17px;
    line-height: 1.5;
  }
  .post__cta-meta {
    display: block;
    margin-top: 12px;
    font-size: 11px;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  @media (max-width: 520px) {
    .post__cta { grid-template-columns: 1fr; gap: 12px; }
    .post__cta .btn { white-space: normal; }
  }
  .post__related {
    margin-top: 64px;
    padding-top: 28px;
    border-top: 3px solid var(--ink);
  }
  .post__related-h {
    margin: 0 0 18px;
    font-size: 15px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: var(--mono, monospace);
  }
  .post__related-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }
  .post__related-list li {
    display: grid;
    gap: 4px;
  }
  .post__related-list a {
    font-weight: 700;
    font-size: 18px;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 2px solid var(--accent);
    justify-self: start;
  }
  .post__related-list a:hover { background: var(--accent-t); }
  .post__related-list span {
    font-size: 15px;
    opacity: 0.75;
    line-height: 1.5;
  }
</style>
