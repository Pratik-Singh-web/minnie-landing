---
import Layout from "./Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  /** Siblings to link at the foot of the post. Chosen in [...slug].astro by
   *  shared tags, because most posts carried no link to another post and the
   *  blog index was the only path between them. */
  related?: { href: string; title: string; description: string }[];
  /** Tags with a hub page to point at. A tag used by only one post has no hub,
   *  so its `href` is undefined and it renders as plain text. */
  tagLinks?: { label: string; href?: string }[];
}

const { title, description, pubDate, updatedDate, tags = [], related = [], tagLinks = [] } = Astro.props;

const base = import.meta.env.BASE_URL;
const site = Astro.site?.href ?? "https://heyminnie.com/";
const url = new URL(Astro.url.pathname, site).href;

// Google truncates a title around 60 characters. Appending " — Minnie" to an
// already-long headline pushed five posts past that, cutting the brand (or the
// end of the headline) off in results — so the suffix is added only when it fits.
const pageTitle = title.length <= 49 ? `${title} — Minnie` : title;

const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });

// BlogPosting replaces the site-wide SoftwareApplication + FAQPage. Google reads
// datePublished/dateModified to judge freshness, which is most of the value here
// — the article rich result itself is limited to news publishers.
const postLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
  ...(tags.length ? { keywords: tags.join(", ") } : {}),
  inLanguage: "en",
  author: { "@type": "Person", name: "Pratik Singh", url: "https://x.com/Sym6ol_" },
  publisher: {
    "@type": "Organization",
    name: "Minnie",
    url: site,
    logo: new URL(`${base}icon-512x512.png`, site).href,
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": url },
  image: new URL(`${base}og-image.png`, site).href,
  isPartOf: { "@type": "Blog", name: "The Minnie blog", url: new URL(`${base}blog/`, site).href },
};
---

<Layout
  title={pageTitle}
  description={description}
  jsonLd={[postLd]}
  ogType="article"
  article={{ published: pubDate, modified: updatedDate, tags }}
  breadcrumbs={[
    { name: "Blog", href: `${base}blog/` },
    { name: title, href: Astro.url.pathname },
  ]}
>
  <Navbar />

  <main class="legal">
    <a href={`${base}blog/`} class="legal__back mono">← all posts</a>

    <h1 class="legal__h1">{title}</h1>
    <p class="legal__date mono">
      {fmt(pubDate)}
      {updatedDate ? ` · updated ${fmt(updatedDate)}` : ""}
      {tagLinks.map((t) => (
        <>
          {" · "}
          {t.href ? <a class="post__tag" href={t.href}>{t.label}</a> : t.label}
        </>
      ))}
    </p>

    <div class="post__body">
      <slot />
    </div>

    {related.length > 0 && (
      <aside class="post__related">
        <h2 class="post__related-h">Keep reading</h2>
        <ul class="post__related-list">
          {related.map((r) => (
            <li>
              <a href={r.href}>{r.title}</a>
              <span>{r.description}</span>
            </li>
          ))}
        </ul>
      </aside>
    )}
  </main>

  <Footer />
</Layout>

<style>
  .post__tag {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
  }
  .post__tag:hover { background: var(--accent-t); }
  .post__related {
    margin-top: 64px;
    padding-top: 28px;
    border-top: 3px solid var(--ink);
  }
  .post__related-h {
    margin: 0 0 18px;
    font-size: 15px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-family: var(--mono, monospace);
  }
  .post__related-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }
  .post__related-list li {
    display: grid;
    gap: 4px;
  }
  .post__related-list a {
    font-weight: 700;
    font-size: 18px;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 2px solid var(--accent);
    justify-self: start;
  }
  .post__related-list a:hover { background: var(--accent-t); }
  .post__related-list span {
    font-size: 15px;
    opacity: 0.75;
    line-height: 1.5;
  }
</style>
