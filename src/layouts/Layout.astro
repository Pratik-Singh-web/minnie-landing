---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Minnie — Give your AI agent a body | macOS AI desktop pet",
  description = "Minnie is a native macOS desktop pet that runs your AI coding agent — talk to her, she executes real tasks, asks permission out loud, and stays fully local. Zero extra AI cost.",
} = Astro.props;

// Live URL derives from astro.config `site` + `base` (GitHub Pages today).
// TODO(pratik): when the custom domain is chosen (minnie.app / getminnie.app / …),
// update `site` in astro.config.mjs, drop `base`, and add public/CNAME.
const base = import.meta.env.BASE_URL;
const site = Astro.site?.href ?? "https://pratik-singh-web.github.io/minnie-landing/";
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(`${base}og-image.png`, site).href;

// Cloudflare Web Analytics (cookieless, privacy-first). To enable:
//   Cloudflare dashboard → Analytics & Logs → Web Analytics → "Add a site" →
//   copy the beacon token → paste it below. The script loads only once it's set.
const CF_ANALYTICS_TOKEN = "d0fa9b521df5404090089c004d4ace87"; // Cloudflare Web Analytics beacon token (public by design)

// Structured data (§12) — SoftwareApplication + FAQPage for rich results.
const softwareLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Minnie",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS",
  description,
  offers: {
    "@type": "Offer",
    price: "39",
    priceCurrency: "USD",
    description: "One-time purchase. Founder price $19 for the first 500 developers.",
  },
};

const faqs = [
  {
    q: "Does Minnie cost extra to run the AI?",
    a: "No. She drives the agent CLI you already use; it holds its own auth and does the reasoning. Zero extra AI cost.",
  },
  {
    q: "Which agents work?",
    a: "Claude Code today, with the full experience. Gemini CLI, Codex, Antigravity and custom command-line agents work too — they run more autonomously, since the voice-consent flow is Claude Code only for now.",
  },
  {
    q: "Is my code private?",
    a: "Yes. On-device voice by default, a local agent CLI, no screen capture, no telemetry. Secrets live in your macOS Keychain, and nothing leaves your Mac unless a tool you approved sends it.",
  },
  {
    q: "Do I need to set anything up?",
    a: "Install the agent CLI once (Claude Code, say) and log in. Minnie's onboarding walks you through the rest.",
  },
  {
    q: "Can I connect my own tools?",
    a: "Yes — a one-click MCP catalog (GitHub, Notion, Slack, Postgres, Figma…), custom servers, and native Sign in with Google for Gmail, Calendar and Chat.",
  },
  {
    q: "Does it work on Windows?",
    a: "macOS first. Windows is on the roadmap.",
  },
];

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Set theme before paint to avoid a flash of the wrong theme. Paper-light
         is the design's default; a stored choice always wins. -->
    <script is:inline>
      (function () {
        try {
          var s = localStorage.getItem("minnie-theme");
          document.documentElement.setAttribute(
            "data-theme",
            s === "dark" || s === "light"
              ? s
              : window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light"
          );
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>
    <meta name="theme-color" content="#f4efe2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101a12" media="(prefers-color-scheme: dark)" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />

    <!-- Open Graph / Twitter -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Minnie" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured data (rich results) -->
    <script type="application/ld+json" set:html={JSON.stringify(softwareLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

    <!-- Fonts: Outfit (display), Karla (body), Space Mono (code) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;700;900&family=Karla:wght@400;600;800&family=Space+Mono:wght@400;700&display=swap"
    />

    <title>{title}</title>

    <!-- Cloudflare Web Analytics — cookieless; loads only when a token is configured -->
    {CF_ANALYTICS_TOKEN && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${CF_ANALYTICS_TOKEN}"}`}
      />
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
