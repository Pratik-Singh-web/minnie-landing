---
import "../styles/global.css";
import { faqs, version, dmgURL } from "../site";

interface Props {
  title?: string;
  description?: string;
  /** Overrides the site-wide structured data. A blog post is an Article, not
   *  the app — repeating SoftwareApplication + FAQPage on every URL tells
   *  Google the same six answers live in six different places. */
  jsonLd?: unknown[];
  /** `article` on blog posts, so the OG card is dated and attributed rather
   *  than being another copy of the home page's card. */
  ogType?: "website" | "article";
  /** Only read when ogType is "article". Emits article:* OG properties. */
  article?: { published: Date; modified?: Date; tags?: string[] };
  /** Trail from the home page to this one, as [label, href] pairs excluding
   *  the home page itself. Rendered as BreadcrumbList so the search result
   *  shows "Minnie › Blog › Post" instead of a bare URL. */
  breadcrumbs?: { name: string; href: string }[];
  /** Keeps a page out of the index. The 404 is the only one: it is served for
   *  every unknown path, so a self-referencing canonical would invite Google
   *  to index "page not found" as if it were a real page. */
  noindex?: boolean;
  /** Path to a social card, relative to the site root, e.g. "og/<slug>.png".
   *  Every card is generated at build time from the page's own title; pages
   *  that pass nothing fall back to the home card. Thirteen identical previews
   *  in a timeline is thirteen links nobody clicks. */
  ogImagePath?: string;
}

const {
  jsonLd,
  ogType = "website",
  article,
  breadcrumbs = [],
  noindex = false,
  ogImagePath,
  // Leads with what people search for: free, Mac, desktop pet, Claude Code.
  title = "Minnie: free AI desktop pet for Mac that runs Claude Code",
  description = "Minnie is a free-for-life Mac desktop pet that runs your AI coding agent: Claude Code, Gemini CLI or Codex. Talk to her, approve every action. No subscription.",
} = Astro.props;

// Live URL derives from astro.config `site` + `base` — heyminnie.com at the
// root since 2026-08-23, so `base` is "/" and these all resolve to the domain.
const base = import.meta.env.BASE_URL;
const site = Astro.site?.href ?? "https://heyminnie.com/";
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(`${base}${ogImagePath ?? "og/home.png"}`, site).href;

// Cloudflare Web Analytics (cookieless, privacy-first). To enable:
//   Cloudflare dashboard → Analytics & Logs → Web Analytics → "Add a site" →
//   copy the beacon token → paste it below. The script loads only once it's set.
const CF_ANALYTICS_TOKEN = "d0fa9b521df5404090089c004d4ace87"; // Cloudflare Web Analytics beacon token (public by design)

// Structured data (§12) — SoftwareApplication + FAQPage for rich results.
const logo = new URL(`${base}icon-512x512.png`, site).href;
const softwareLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Minnie",
  alternateName: "Minnie desktop pet",
  applicationCategory: "DeveloperApplication",
  applicationSubCategory: "AI coding assistant",
  operatingSystem: "macOS 14 or later (Apple Silicon)",
  softwareVersion: version,
  downloadUrl: dmgURL,
  url: site,
  image: logo,
  screenshot: ogImage,
  description,
  isAccessibleForFree: true,
  featureList: [
    "Desktop pet that runs Claude Code, Gemini CLI, Codex or a custom agent CLI",
    "Voice requests with on-device speech recognition",
    "Asks out loud before edits and commands (Claude Code)",
    "One-click MCP tools: GitHub, Notion, Slack, Postgres, Figma",
    "Secrets stored in the macOS Keychain",
  ],
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
    availability: "https://schema.org/InStock",
    description: "Free for life. Optional extra characters may be sold later as one-time purchases.",
  },
  publisher: { "@id": `${site}#org` },
};

const orgLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${site}#org`,
  name: "Minnie",
  url: site,
  logo,
  // `sameAs` is a list of profiles Google will FETCH to corroborate this
  // Organization. The GitHub entry pointed at a private repo, so the one
  // verification it offered resolved to a 404 — worse than listing nothing.
  sameAs: ["https://x.com/Sym6ol_"],
};

const webLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Minnie",
  url: site,
  publisher: { "@id": `${site}#org` },
};


const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

// SoftwareApplication + FAQPage describe the home page and nothing else. Left
// as the default they rode along on /privacy, /terms, /support, /refund and
// /download too — the same seven answers claiming to live at six URLs, which is
// what gets an FAQ rich result dropped. Every other page now passes its own.
const homeLd = [softwareLd, orgLd, webLd, faqLd];

const crumbLd =
  breadcrumbs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [{ name: "Minnie", href: base }, ...breadcrumbs].map(
          (c, i) => ({
            "@type": "ListItem",
            position: i + 1,
            name: c.name,
            item: new URL(c.href, site).href,
          })
        ),
      }
    : null;

const structured = [...(jsonLd ?? homeLd), ...(crumbLd ? [crumbLd] : [])];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Theme before first paint, so there is no flash. A choice made with the
         nav toggle wins; otherwise follow the system. -->
    <script is:inline>
      (function () {
        var t;
        try { t = localStorage.getItem("minnie-theme"); } catch (e) {}
        if (t !== "light" && t !== "dark") {
          t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.setAttribute("data-theme", t);
      })();
    </script>
    <meta name="theme-color" content="#fffcf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a100b" media="(prefers-color-scheme: dark)" />
    <meta name="description" content={description} />
    {noindex
      ? <meta name="robots" content="noindex, follow" />
      : <link rel="canonical" href={canonical} />}
    <link rel="alternate" type="application/rss+xml" title="The Minnie blog" href={`${base}rss.xml`} />
    <!-- Favicons. Google fetches /favicon.ico on its own schedule and wants a
         square icon that is a multiple of 48px, so the .ico is a real multi-size
         icon (16/32/48) and the linked PNGs are 96 and 192 — NOT the 32px one
         that used to sit here mislabelled as .ico, which is why search results
         showed the generic globe. Artwork is the macOS app icon, so the tab,
         the search result and the app all match. -->
    <link rel="icon" href={`${base}favicon.ico`} sizes="any" />
    <link rel="icon" type="image/png" sizes="96x96" href={`${base}favicon-96x96.png`} />
    <link rel="icon" type="image/png" sizes="192x192" href={`${base}favicon-192x192.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />

    <!-- Open Graph / Twitter -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Minnie" />
    {ogType === "article" && article && (
      <>
        <meta property="article:published_time" content={article.published.toISOString()} />
        {article.modified && (
          <meta property="article:modified_time" content={article.modified.toISOString()} />
        )}
        {(article.tags ?? []).map((t) => <meta property="article:tag" content={t} />)}
      </>
    )}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} — heyminnie.com`} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@Sym6ol_" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured data (rich results). Pages that describe something other
         than the app pass their own via the `jsonLd` prop. -->
    {structured.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}

    <!-- Fonts: Bricolage Grotesque carries display AND body — the system is a
         single grotesque at two weights. JetBrains Mono is only for code. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700;12..96,800&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <title>{title}</title>

    <!-- Cloudflare Web Analytics — cookieless; loads only when a token is configured -->
    {CF_ANALYTICS_TOKEN && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${CF_ANALYTICS_TOKEN}"}`}
      />
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
