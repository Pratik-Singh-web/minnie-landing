---
import Minnie from "./Minnie.astro";
const base = import.meta.env.BASE_URL;

// Small secrets, each a different kind of trigger, each teaching one true
// thing about Minnie. Found ones are remembered in localStorage and counted
// ("Secret 3 of 7") so people go looking for the rest.
//
//   hey      type "hey minnie"            → the tour (EasterEgg.astro)
//   konami   ↑↑↓↓←→←→BA                   → she celebrates a green build
//   rmrf     type "rm -rf"                → the consent layer
//   alt      ⌥/Alt + Space                → the real hide/summon shortcut
//   nap      45s idle                     → she naps, notices you're back
//   grab     drag the hero Minnie (mouse) → she floats above everything
//   owl      visit 00:00–04:59 local      → late-night company
---

<div class="sx-toasts" id="sx-toasts" aria-live="polite"></div>
<div class="sx-rain" id="sx-rain" aria-hidden="true"></div>

<!-- The pop-out pet for "grab her". Hidden until she is dragged. -->
<div class="sx-pop" id="sx-pop" hidden>
  <Minnie id="sx-pop-pet" state="float" size={130} label="Minnie, floating above the page" />
  <button type="button" class="sx-pop__home" id="sx-pop-home" aria-label="Send Minnie back">×</button>
</div>

<script define:vars={{ base }}>
  const S = `${base}minnie/`;
  const SECRETS = {
    hey: "Hey Minnie",
    konami: "Green build",
    rmrf: "rm -rf",
    alt: "⌥Space",
    nap: "Nap time",
    grab: "Grab her",
    owl: "Night owl",
  };
  const TOTAL = Object.keys(SECRETS).length;
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  let found = [];
  try { found = JSON.parse(localStorage.getItem("minnie-secrets") || "[]"); } catch (e) {}

  const toasts = document.getElementById("sx-toasts");
  function toast({ img = "still-curious", title, text, actions = [], ms = 7000 }) {
    const t = document.createElement("div");
    t.className = "sx-toast";
    // The avatar is built with DOM calls rather than written into the innerHTML
    // template below. Written as a string, the image tag sat in the page source
    // with its src still an unresolved template literal — never rendered, but
    // HTML scanners that match image tags with a regex read it as a real image
    // and flagged it. Bing's crawler did exactly that on the home page.
    // (Hence no example here: a literal tag in this comment would ship too.)
    const avatar = document.createElement("img");
    avatar.src = `${S}${img}.webp`;
    avatar.width = 44;
    avatar.height = 44;
    avatar.alt = "";
    t.innerHTML = `<div class="sx-toast__body"><p class="sx-toast__t"></p><p class="sx-toast__p"></p><div class="sx-toast__a"></div></div>
      <button type="button" class="sx-toast__x" aria-label="Dismiss">×</button>`;
    t.prepend(avatar);
    t.querySelector(".sx-toast__t").textContent = title;
    t.querySelector(".sx-toast__p").innerHTML = text;
    const a = t.querySelector(".sx-toast__a");
    actions.forEach(([label, fn, kind]) => {
      const b = document.createElement("button");
      b.type = "button";
      b.className = `sx-btn ${kind || ""}`;
      b.textContent = label;
      b.addEventListener("click", () => { fn(t); });
      a.append(b);
    });
    const kill = () => { t.classList.remove("is-in"); setTimeout(() => t.remove(), 250); };
    t.querySelector(".sx-toast__x").addEventListener("click", kill);
    toasts.append(t);
    requestAnimationFrame(() => t.classList.add("is-in"));
    if (ms) setTimeout(kill, ms);
    t.kill = kill;
    return t;
  }

  function updateCount() {
    document.querySelectorAll("[data-secret-count]").forEach((el) => {
      el.hidden = found.length === 0;
      el.textContent = `🥚 ${found.length}/${TOTAL} secrets found`;
    });
  }

  // Record a find. Returns the "Secret n of 7" label, or "" if already found.
  function secret(id) {
    if (!SECRETS[id]) return "";
    if (found.includes(id)) return "";
    found.push(id);
    try { localStorage.setItem("minnie-secrets", JSON.stringify(found)); } catch (e) {}
    updateCount();
    return `Secret ${found.length} of ${TOTAL}`;
  }
  const label = (id, fallback) => secret(id) || fallback;
  window.minnieSecret = secret;
  updateCount();

  const hero = () => document.getElementById("hero-pet");
  const isTyping = (t) => t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName));

  // ── 2. Konami → a green build ────────────────────────────────────────────
  const KONAMI = ["ArrowUp", "ArrowUp", "ArrowDown", "ArrowDown", "ArrowLeft", "ArrowRight", "ArrowLeft", "ArrowRight", "b", "a"];
  let kpos = 0;
  addEventListener("keydown", (e) => {
    const k = e.key.length === 1 ? e.key.toLowerCase() : e.key;
    kpos = k === KONAMI[kpos] ? kpos + 1 : k === KONAMI[0] ? 1 : 0;
    if (kpos === KONAMI.length) { kpos = 0; greenBuild(); }
  });
  function greenBuild() {
    const tag = label("konami", "Green build");
    if (!reduce) {
      const rain = document.getElementById("sx-rain");
      const pics = ["still-curious", "still-content", "still-cheeky", "still-float"];
      for (let i = 0; i < 28; i++) {
        const img = document.createElement("img");
        img.src = `${S}${pics[i % pics.length]}.webp`;
        img.alt = "";
        img.style.left = `${Math.random() * 100}vw`;
        img.style.animationDelay = `${Math.random() * 0.9}s`;
        img.style.setProperty("--spin", `${(Math.random() * 2 - 1) * 260}deg`);
        img.style.setProperty("--sz", `${32 + Math.random() * 30}px`);
        rain.append(img);
        setTimeout(() => img.remove(), 3600);
      }
    }
    const h = hero();
    if (h) { const prev = h.dataset.state; h.dataset.state = "happy"; setTimeout(() => { h.dataset.state = prev; }, 3200); }
    toast({ img: "still-cheeky", title: `${tag} · ✓ 42 tests passed`,
      text: "This is how she feels about every green run. On your Mac she celebrates when your agent's tests pass." });
  }

  // ── 3. "rm -rf" → the consent layer ──────────────────────────────────────
  let raw = "";
  addEventListener("keydown", (e) => {
    if (isTyping(e.target) || e.metaKey || e.ctrlKey || e.key.length !== 1) return;
    raw = (raw + e.key.toLowerCase()).slice(-12);
    if (raw.replace(/\s+/g, " ").endsWith("rm -rf")) { raw = ""; rmrf(); }
  });
  function rmrf() {
    const tag = label("rmrf", "rm -rf");
    const h = hero();
    if (h) h.dataset.state = "float";
    toast({ img: "still-float", title: `${tag} · Whoa there`, ms: 0,
      text: "I want to run <code>rm -rf</code>. That deletes things for good. <b>Ok?</b>",
      actions: [
        ["Deny", (t) => { t.kill(); toast({ img: "still-content", title: "Good call", text: "Saying no is always a normal answer. Nothing ran, nothing changed." }); }, "sx-btn--deny"],
        ["Allow", (t) => { t.kill(); toast({ img: "still-cheeky", title: "Nice try 😄", text: "Nothing ran here. On your Mac she reads risky commands out loud and waits — that's the whole point of asking first." }); }],
      ] });
  }

  // ── 4. ⌥/Alt + Space → hide and summon ───────────────────────────────────
  let hiddenByShortcut = false;
  addEventListener("keydown", (e) => {
    if (!(e.altKey && e.code === "Space")) return;
    e.preventDefault();
    const tag = label("alt", "⌥Space");
    const targets = [document.getElementById("hero-pet-wrap"), document.getElementById("sx-pop")].filter(Boolean);
    hiddenByShortcut = !hiddenByShortcut;
    targets.forEach((el) => el.classList.toggle("sx-gone", hiddenByShortcut));
    toast({ img: hiddenByShortcut ? "still-content" : "still-curious",
      title: hiddenByShortcut ? `${tag} · Tucked away` : "She's back",
      text: hiddenByShortcut ? "Same shortcut as on your Mac: ⌥Space hides her while you focus. Press it again to bring her back."
                             : "⌥Space summons her right where she was." });
  });

  // ── 5. Idle → nap, and noticing you're back ──────────────────────────────
  let idleTimer, napping = false, napPrev = "float";
  const IDLE_MS = 45000;
  const armIdle = () => { clearTimeout(idleTimer); idleTimer = setTimeout(nap, IDLE_MS); };
  function nap() {
    if (document.hidden || napping) return;
    napping = true;
    const h = hero();
    if (h) { napPrev = h.dataset.state || "float"; h.dataset.state = "sleep"; }
    toast({ img: "still-content", title: `${label("nap", "Nap time")} · Zzz…`,
      text: "You went quiet, so she dozed off. On your Mac she naps while you focus and wakes the moment you're back." });
  }
  function wake() {
    if (napping) {
      napping = false;
      const h = hero();
      if (h) { h.dataset.state = "happy"; setTimeout(() => { h.dataset.state = napPrev; }, 2400); }
      toast({ img: "still-curious", title: "You're back! 👋", text: "She's always the first to notice." , ms: 4000 });
    }
    armIdle();
  }
  ["pointermove", "keydown", "scroll", "touchstart"].forEach((ev) => addEventListener(ev, wake, { passive: true }));
  armIdle();

  // ── 6. Grab her → she floats above the page ──────────────────────────────
  const pop = document.getElementById("sx-pop");
  const popPet = document.getElementById("sx-pop-pet");
  const wrap = document.getElementById("hero-pet-wrap");
  let drag = null;
  const place = (x, y) => {
    const w = pop.offsetWidth || 130;
    pop.style.left = `${Math.min(Math.max(x - w / 2, 8), innerWidth - w - 8)}px`;
    pop.style.top = `${Math.min(Math.max(y - w / 2, 8), innerHeight - w - 8)}px`;
  };
  wrap?.addEventListener("pointerdown", (e) => {
    if (e.pointerType === "touch" || e.button !== 0) return;
    drag = { x: e.clientX, y: e.clientY, live: false };
  });
  addEventListener("pointermove", (e) => {
    if (!drag) return;
    if (!drag.live && Math.hypot(e.clientX - drag.x, e.clientY - drag.y) > 12) {
      drag.live = true;
      pop.hidden = false;
      pop.classList.add("is-drag");
      wrap.classList.add("sx-gone");
      popPet.dataset.state = "float";
      document.body.classList.add("sx-grabbing");
    }
    if (drag.live) { e.preventDefault(); place(e.clientX, e.clientY); }
  });
  addEventListener("pointerup", () => {
    if (!drag) return;
    const was = drag.live;
    drag = null;
    document.body.classList.remove("sx-grabbing");
    if (!was) return;
    pop.classList.remove("is-drag");
    popPet.dataset.state = "stand";
    toast({ img: "still-float", title: `${label("grab", "Grab her")} · She's free`,
      text: "Now she floats above everything, even while you scroll — just like above your windows on your Mac. Drag her anywhere; × sends her home." });
  });
  pop.addEventListener("pointerdown", (e) => {
    if (e.target.closest(".sx-pop__home") || e.pointerType === "touch") return;
    drag = { x: e.clientX, y: e.clientY, live: true };
    pop.classList.add("is-drag");
    document.body.classList.add("sx-grabbing");
  });
  document.getElementById("sx-pop-home")?.addEventListener("click", () => {
    pop.hidden = true;
    wrap?.classList.remove("sx-gone");
  });

  // ── 7. Night owl ─────────────────────────────────────────────────────────
  const hour = new Date().getHours();
  let seenOwl = false;
  try { seenOwl = sessionStorage.getItem("minnie-owl") === "1"; } catch (e) {}
  if (hour < 5 && !seenOwl) {
    setTimeout(() => {
      try { sessionStorage.setItem("minnie-owl", "1"); } catch (e) {}
      toast({ img: "still-content", title: `${label("owl", "Night owl")} · It's late 🌙`,
        text: "Coding past midnight? She'll keep you company — and nudge you to commit before bed.", ms: 9000 });
    }, 4000);
  }
</script>

<style is:global>
  /* Global: toasts and confetti are created at runtime (see EasterEgg.astro). */
  .sx-toasts {
    position: fixed;
    left: 20px;
    bottom: 20px;
    z-index: 85;
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: min(360px, calc(100vw - 32px));
    pointer-events: none;
  }
  @media (max-width: 560px) { .sx-toasts { left: 16px; bottom: 16px; } }

  .sx-toast {
    display: grid;
    grid-template-columns: 44px 1fr auto;
    gap: 12px;
    align-items: start;
    padding: 12px 12px 12px 14px;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: var(--card);
    color: var(--ink);
    box-shadow: 0 14px 40px rgba(46, 27, 18, 0.2);
    pointer-events: auto;
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.22s ease, transform 0.22s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sx-toast.is-in { opacity: 1; transform: none; }
  .sx-toast img { width: 44px; height: 44px; object-fit: contain; }
  .sx-toast__t { margin: 0; font-size: 13.5px; font-weight: 800; letter-spacing: -0.01em; color: var(--accent-ink); }
  .sx-toast__p { margin: 3px 0 0; font-size: 13.5px; line-height: 1.45; color: var(--ink-dim); }
  .sx-toast__p code {
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 1px 4px;
    border-radius: 4px;
    background: var(--sunk);
    color: var(--ink);
  }
  .sx-toast__p b { color: var(--ink); }
  .sx-toast__a { display: flex; gap: 8px; margin-top: 10px; }
  .sx-toast__a:empty { display: none; }
  .sx-toast__x {
    width: 24px;
    height: 24px;
    border: 0;
    border-radius: 7px;
    background: transparent;
    color: var(--ink-soft);
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
  }
  .sx-toast__x:hover { background: var(--sunk); color: var(--ink); }

  .sx-btn {
    padding: 7px 12px;
    border: 1px solid color-mix(in srgb, var(--ink) 22%, transparent);
    border-radius: 10px;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
  }
  .sx-btn:hover { border-color: var(--ink); }
  .sx-btn--deny { border-color: transparent; background: var(--grad); color: var(--on-accent); }

  /* Green-build confetti: tiny Minnies falling and spinning. */
  .sx-rain { position: fixed; inset: 0; z-index: 84; pointer-events: none; overflow: hidden; }
  .sx-rain img {
    position: absolute;
    top: -70px;
    width: var(--sz);
    height: var(--sz);
    animation: sxFall 2.6s cubic-bezier(0.3, 0.6, 0.5, 1) forwards;
  }
  @keyframes sxFall {
    to { transform: translateY(calc(100vh + 120px)) rotate(var(--spin)); }
  }

  /* Hidden by ⌥Space or lifted out by "grab her". */
  .sx-gone { opacity: 0; transform: scale(0.85) !important; transition: opacity 0.25s ease, transform 0.25s ease; pointer-events: none; }

  .sx-pop {
    position: fixed;
    left: calc(100vw - 170px);
    top: calc(100vh - 220px);
    z-index: 83;
    width: 130px;
    height: 130px;
    cursor: grab;
    touch-action: none;
    filter: drop-shadow(0 14px 18px rgba(46, 27, 18, 0.22));
  }
  .sx-pop[hidden] { display: none; }
  .sx-pop.is-drag { cursor: grabbing; }
  .sx-pop .minnie { width: 130px; height: 130px; }
  .sx-pop__home {
    position: absolute;
    top: 0;
    right: 0;
    width: 24px;
    height: 24px;
    border: 1px solid var(--line);
    border-radius: 99px;
    background: var(--card);
    color: var(--ink-dim);
    font-size: 15px;
    line-height: 1;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  .sx-pop:hover .sx-pop__home,
  .sx-pop__home:focus-visible { opacity: 1; }
  body.sx-grabbing { user-select: none; cursor: grabbing; }

  @media (prefers-reduced-motion: reduce) {
    .sx-toast, .sx-gone { transition: none; }
  }
</style>
