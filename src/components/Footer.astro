---
import Pet from "./Pet.astro";
import { contactEmail } from "../legal";
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="wrap">
    <div class="foot__cols">
      <div>
        <div class="foot__brand">
          <span class="foot__mark">
            <Pet size={22} />
          </span>
          <span class="foot__word">Minnie</span>
        </div>
        <p class="foot__blurb">
          A native macOS companion that brings your AI coding agent to life. She listens, runs your
          agent, asks permission, and reacts.
        </p>
        <span class="foot__meta">on-device voice · runs on your mac · local-only</span>
      </div>

      <div>
        <h4 class="foot__h">Product</h4>
        <div class="foot__links">
          <a href={`${import.meta.env.BASE_URL}#features`}>Features</a>
          <a href={`${import.meta.env.BASE_URL}#privacy`}>Privacy</a>
          <a href={`${base}blog/`}>Blog</a>
          <a href={`${import.meta.env.BASE_URL}download`}>Download beta</a>
        </div>
      </div>

      <div>
        <h4 class="foot__h">Connect</h4>
        <div class="foot__links">
          <a href="https://x.com/Sym6ol_" target="_blank" rel="noopener noreferrer">X (Twitter)</a>
          <a href="https://github.com/Pratik-Singh-web/Minnie" target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href={`${import.meta.env.BASE_URL}#faq`}>FAQ</a>
          <a href={`${base}support`}>Support</a>
          <a href={`mailto:${contactEmail}`}>Send feedback</a>
        </div>
      </div>
    </div>

    <div class="foot__rule">
      <span>© {year} Minnie</span>
      <span class="foot__links foot__legal">
        <a href={`${base}terms`}>Terms</a>
        <a href={`${base}privacy`}>Privacy</a>
        <a href={`${base}refund`}>Refunds</a>
        <a href={`${base}support`}>Support</a>
      </span>
      <span class="foot__tag">Deny is a hug, not a scold</span>
    </div>
  </div>
</footer>

<style>
  .foot {
    width: 100%;
    background: var(--green-deep);
    color: #b9cfc0;
    padding: 52px 0 32px;
  }

  .foot__cols {
    display: grid;
    gap: 36px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 800px) {
    .foot__cols { grid-template-columns: 2fr 1fr 1fr; }
  }

  .foot__brand {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }
  .foot__mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: var(--pink);
    flex-shrink: 0;
  }
  .foot__word {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 800;
    color: var(--on-band);
    text-transform: uppercase;
  }

  .foot__blurb {
    margin: 0 0 14px;
    font-size: 16px;
    max-width: 26rem;
    line-height: 1.6;
  }
  .foot__meta {
    font-size: 11px;
    text-transform: uppercase;
    color: #8ba393;
  }

  .foot__h {
    margin: 0 0 14px;
    font-family: var(--font-display);
    font-size: 14.5px;
    font-weight: 800;
    color: var(--on-band-dim);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .foot__links {
    display: flex;
    flex-direction: column;
    gap: 9px;
    font-size: 16px;
  }
  .foot__links a { color: #b9cfc0; }
  .foot__links a:hover { color: var(--on-band-dim); }

  .foot__rule {
    margin-top: 40px;
    padding-top: 22px;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-size: 11px;
    text-transform: uppercase;
  }
  .foot__legal { flex-direction: row; }
  .foot__tag { color: var(--on-band-dim); }
</style>
