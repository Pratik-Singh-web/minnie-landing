---
import { contactEmail } from "../legal";
import EasterEgg from "./EasterEgg.astro";
import Secrets from "./Secrets.astro";
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();

const cols = [
  {
    h: "Product",
    links: [
      { t: "Features", href: `${base}#features` },
      { t: "Pets", href: `${base}#customize` },
      { t: "Pricing", href: `${base}#pricing` },
      { t: "Download beta", href: `${base}download/` },
    ],
  },
  {
    h: "Works with",
    links: [
      { t: "Claude Code", href: `${base}#agents` },
      { t: "Gemini CLI", href: `${base}#agents` },
      { t: "Codex", href: `${base}#agents` },
      { t: "MCP tools", href: `${base}#mcp` },
    ],
  },
  {
    h: "Resources",
    links: [
      { t: "Blog", href: `${base}blog/` },
      { t: "FAQ", href: `${base}#faq` },
      { t: "Support", href: `${base}support/` },
      { t: "Send feedback", href: `mailto:${contactEmail}` },
    ],
  },
  {
    h: "Connect",
    links: [
      { t: "X (Twitter)", href: "https://x.com/Sym6ol_", ext: true },
      // No GitHub link: the app repo is private, so the link 404'd for every
      // visitor who clicked it. Put it back only when that repo is public —
      // and add it to the Organization `sameAs` in Layout.astro at the same
      // time, since the two have to agree about where Minnie lives.
    ],
  },
];
---

<footer class="foot">
  <div class="wrap">
    <div class="foot__cols">
      <div>
        <div class="foot__brand">
          <img class="foot__mark" src={`${base}favicon-96x96.png`} width="40" height="40" alt="" loading="lazy" decoding="async" />
          <span class="foot__word">minnie</span>
        </div>
        <p class="foot__blurb">A desktop pet for your AI coding agent.<br />She listens, works, and asks first.</p>
      </div>

      {cols.map((c) => (
        <div>
          {/* h2, not h4: these are top-level labels inside the footer
              landmark, and an h4 straight after the page's h2s left every
              page with a broken heading ladder. Styling is on the class. */}
          <h2 class="foot__h">{c.h}</h2>
          <ul class="foot__links">
            {c.links.map((l) => (
              <li>
                <a href={l.href} {...(l.ext ? { target: "_blank", rel: "noopener noreferrer" } : {})}>{l.t}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="foot__rule">
      <span>© {year} Minnie</span>
      <a href={`${base}privacy/`}>Privacy</a>
      <a href={`${base}terms/`}>Terms</a>
      <a href={`${base}refund/`}>Refunds</a>
      <span class="foot__count" data-secret-count hidden></span>
      <button type="button" class="foot__psst" data-egg title="Say hi">psst… type “hey minnie”</button>
    </div>
  </div>
</footer>

<EasterEgg />
<Secrets />

<style>
  .foot {
    margin-top: 64px;
    padding: 80px 0 32px;
    background: var(--foot);
    color: var(--on-band-dim);
  }
  .foot__cols {
    display: grid;
    gap: 36px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .foot__cols > :first-child { grid-column: 1 / -1; }
  @media (min-width: 900px) {
    .foot__cols { grid-template-columns: 1.6fr repeat(4, 1fr); }
    .foot__cols > :first-child { grid-column: auto; }
  }

  .foot__brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .foot__mark {
    display: block;
    width: 40px;
    height: 40px;
  }
  .foot__word {
    font-size: 30px;
    font-weight: 800;
    letter-spacing: -0.06em;
    color: var(--on-band);
  }
  .foot__blurb {
    margin: 16px 0 0;
    font-size: 15px;
    line-height: 1.6;
  }

  .foot__h {
    margin: 0 0 16px;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--peach);
  }
  .foot__links {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 14.5px;
  }
  .foot a { color: #f6e6d8; }
  .foot a:hover { color: var(--peach); }

  /* The easter egg's hint, and its trigger on phones (no keyboard to type on). */
  .foot__count {
    margin-left: auto;
    font-size: 13px;
    color: var(--peach);
  }
  .foot__count:not([hidden]) + .foot__psst { margin-left: 0; }
  .foot__psst {
    margin-left: auto;
    padding: 0;
    border: 0;
    background: none;
    color: var(--on-band-dim);
    font: inherit;
    font-size: 13px;
    font-style: italic;
    cursor: pointer;
    opacity: 0.75;
  }
  .foot__psst:hover { color: var(--peach); opacity: 1; }

  .foot__rule {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    margin-top: 64px;
    padding-top: 22px;
    border-top: 1px solid #4a2e22;
    font-size: 13px;
  }
</style>
