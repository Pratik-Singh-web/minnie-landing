---
// Scrolling band between sections. The set of items is rendered twice — the
// second copy is aria-hidden and only exists so the loop has no seam.
interface Props {
  items: string[];
  sep?: string;
  background?: string;
  color?: string;
  reverse?: boolean;
  display?: boolean; // display face instead of mono
}
const {
  items,
  sep = "★",
  background = "var(--band)",
  color = "var(--on-band)",
  reverse = false,
  display = false,
} = Astro.props;

const font = display
  ? "font-family:var(--font-display); font-size: 16.5px; font-weight:800;"
  : "font-family:var(--font-sans); font-size: 13px; font-weight:600; letter-spacing:.02em;";
---

<div class="marquee" style={`background:${background};`}>
  <div class={`marquee__track${reverse ? " marquee__track--rev" : ""}`} style={`${font} color:${color};`}>
    <span class="marquee__set">
      {items.map((item) => (
        <>
          <span>{item}</span>
          <span>{sep}</span>
        </>
      ))}
    </span>
    <span class="marquee__set" aria-hidden="true">
      {items.map((item) => (
        <>
          <span>{item}</span>
          <span>{sep}</span>
        </>
      ))}
    </span>
  </div>
</div>
