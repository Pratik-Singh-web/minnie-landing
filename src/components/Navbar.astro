---
const base = import.meta.env.BASE_URL;
---

<!-- Logo left, one text link and one key right. Nothing in the middle. -->
<header class="nav">
  <div class="nav__inner">
    <a href={base} class="nav__brand" aria-label="Minnie home">
      <img class="nav__mark" src={`${base}favicon-96x96.png`} width="34" height="34" alt="" />
      <span class="nav__word">minnie</span>
      <span class="nav__script">beta</span>
    </a>

    <div class="nav__actions">
      <a href={`${base}blog/`} class="nav__link">Blog</a>
      <button type="button" id="theme-toggle" class="icon-btn nav__theme" aria-label="Switch between light and dark" title="Light / dark">
        <svg class="theme-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="theme-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
      <a href={`${base}download`} class="btn btn--sm">Download beta</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: saturate(1.6) blur(12px);
  }
  .nav__inner {
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    max-width: 1180px;
    padding: 21px 24px;
  }

  .nav__brand {
    display: flex;
    align-items: center;
    gap: 9px;
  }
  /* The macOS app icon, so the site, the tab and the Dock all match. */
  .nav__mark {
    display: block;
    width: 34px;
    height: 34px;
    flex-shrink: 0;
  }
  .nav__word {
    font-family: var(--font-display);
    font-size: 25px;
    font-weight: 800;
    letter-spacing: -0.06em;
    color: var(--ink);
  }
  /* The second half of the lockup, in the pink aside voice. */
  .nav__script {
    margin-left: -3px;
    font-family: var(--font-display);
    font-size: 25px;
    font-weight: 700;
    font-style: italic;
    letter-spacing: -0.04em;
    color: var(--quip);
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .nav__link {
    font-size: 16px;
    font-weight: 600;
    color: var(--ink);
  }
  .nav__link:hover { color: var(--accent-ink); }

  .nav__theme { width: 38px; height: 38px; }

  @media (max-width: 560px) {
    .nav__inner { padding: 16px; }
    .nav__actions { gap: 14px; }
    .nav__word,
    .nav__script { font-size: 21px; }
  }
</style>

<script>
  // Mirrors the pre-paint script in Layout.astro.
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const next = document.documentElement.getAttribute("data-theme") === "dark" ? "light" : "dark";
    document.documentElement.setAttribute("data-theme", next);
    try { localStorage.setItem("minnie-theme", next); } catch (e) {}
  });
</script>
