---
import Pet from "./Pet.astro";
---

<!-- Reading progress — a yellow bar with an ink edge, pinned above everything -->
<div class="progress-rail" aria-hidden="true">
  <div class="progress-fill" id="scroll-progress"></div>
</div>

<header class="nav">
  <div class="nav__inner">
    <a href={import.meta.env.BASE_URL} class="nav__brand">
      <span class="nav__mark jitter">
        <Pet size={24} />
      </span>
      <span class="nav__word">Minnie</span>
      <span class="nav__soon mono">beta</span>
    </a>

    <nav class="nav__links">
      <a href={`${import.meta.env.BASE_URL}#features`}>Features</a>
      <a href={`${import.meta.env.BASE_URL}#demo`}>Playground</a>
      <a href={`${import.meta.env.BASE_URL}#customize`}>Customize</a>
      <a href={`${import.meta.env.BASE_URL}#mcp`}>MCP</a>
      <a href={`${import.meta.env.BASE_URL}#faq`}>FAQ</a>
    </nav>

    <div class="nav__actions">
      <button type="button" id="theme-toggle" class="icon-btn" aria-label="Toggle light and dark theme" title="Toggle theme">
        <svg class="theme-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="theme-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
      <a href={`${import.meta.env.BASE_URL}download`} class="btn btn--sm">Download beta</a>
    </div>
  </div>
</header>

<style>
  .progress-rail {
    position: fixed;
    top: 0;
    left: 0;
    height: 6px;
    width: 100%;
    z-index: 60;
    background: transparent;
    pointer-events: none;
  }
  .progress-fill {
    height: 100%;
    width: 0%;
    background: var(--yellow);
    border-right: 3px solid var(--line);
  }

  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    border-bottom: 3px solid var(--line);
    background: var(--paper);
  }
  .nav__inner {
    margin: 0 auto;
    display: flex;
    height: 72px;
    width: 100%;
    max-width: 1180px;
    align-items: center;
    justify-content: space-between;
    padding: 0 24px;
    gap: 16px;
  }

  .nav__brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .nav__mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 3px solid var(--line);
    background: var(--pink);
    box-shadow: var(--sh-sm);
    flex-shrink: 0;
  }
  .nav__word {
    font-family: Outfit, sans-serif;
    font-size: 24px;
    font-weight: 900;
    letter-spacing: -0.03em;
    color: var(--ink);
    text-transform: uppercase;
  }
  .nav__soon {
    border: 2px solid var(--line);
    background: var(--yellow);
    color: #101a12;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .nav__links {
    display: none;
    align-items: center;
    gap: 22px;
    font-size: 14px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    min-width: 0;
  }
  .nav__links a {
    border-bottom: 3px solid transparent;
  }
  .nav__links a:hover {
    border-bottom-color: var(--yellow);
    color: var(--ink);
  }
  @media (min-width: 1080px) {
    .nav__links { display: flex; }
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* Narrow phones: drop the "soon" stamp and tighten the bar so the CTA
     stays on screen rather than being clipped at the right edge. */
  @media (max-width: 560px) {
    .nav__inner {
      padding: 0 16px;
      gap: 10px;
    }
    .nav__soon { display: none; }
    .nav__word { font-size: 20px; }
    .nav__actions .btn {
      padding: 10px 12px;
      font-size: 12px;
    }
  }
</style>

<script>
  // Scroll progress
  const bar = document.getElementById("scroll-progress");
  const onScroll = () => {
    const h = document.documentElement;
    const max = h.scrollHeight - h.clientHeight;
    const pct = max > 0 ? (h.scrollTop / max) * 100 : 0;
    if (bar) bar.style.width = pct + "%";
  };
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  // Theme toggle — mirrors the pre-paint script in Layout.astro
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const next = document.documentElement.getAttribute("data-theme") === "dark" ? "light" : "dark";
    document.documentElement.setAttribute("data-theme", next);
    try {
      localStorage.setItem("minnie-theme", next);
    } catch (e) {}
  });
</script>
