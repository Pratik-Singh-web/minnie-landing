---
// Reusable email-capture form (Hero + Final CTA share this).
// Signups save straight to YOUR Google Sheet via a Google Apps Script web app —
// free, no third party, you own the data. Setup + the script live in
// WAITLIST_SETUP.md; paste your /exec deployment URL into WAITLIST_ENDPOINT below.
// Until then it falls back to an optimistic success so the page stays usable.
interface Props {
  source?: string;
  center?: boolean;
  note?: boolean;
}
const { source = "hero", center = false, note = true } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<div class="waitlist" style={center ? "width:100%; max-width:30rem;" : "width:100%; max-width:30rem;"}>
  <form class="waitlist-form" style={center ? "justify-content:center;" : ""} novalidate>
    <input type="hidden" name="source" value={source} />
    <!-- Honeypot: off-screen + aria-hidden. Humans never see it; bots that fill it are dropped. -->
    <div aria-hidden="true" style="position:absolute;left:-9999px;top:-9999px;width:1px;height:1px;overflow:hidden">
      <label>Company (leave this empty)
        <input type="text" name="company" tabindex="-1" autocomplete="off" />
      </label>
    </div>
    <input
      type="email"
      name="email"
      required
      autocomplete="email"
      placeholder="you@yourmac.dev"
      class="field"
      style="flex:1 1 210px;"
      aria-label="Email address"
    />
    <button type="submit" class="btn">
      <span class="wl-label">Join waitlist</span>
      <span class="wl-spinner" hidden>Joining…</span>
    </button>
  </form>

  <p class="wl-stamp" hidden>✓ You're on the list — we'll email you when the next build drops</p>
  <p class="wl-error" hidden>Hmm, that didn't go through. Mind trying again?</p>

  {note && (
    <p class="wl-note mono">// one email on launch day. that's the whole plan. · <a href={`${base}privacy`}>privacy</a></p>
  )}
</div>

<style>
  .waitlist-form {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .wl-stamp,
  .wl-error {
    margin: 12px 0 0;
    display: inline-block;
    border: 3px solid var(--line);
    padding: 8px 14px;
    font-size: 13px;
    font-weight: 800;
    box-shadow: var(--sh-sm);
    animation: stamp 0.35s steps(3, end) both;
  }
  .wl-stamp {
    background: var(--yellow);
    color: #101a12;
  }
  .wl-error {
    background: var(--red);
    color: #fffdf5;
  }

  .wl-note {
    margin: 12px 0 0;
    font-size: 11px;
    color: var(--ink-soft);
  }
  .wl-note a {
    color: var(--ink-soft);
    text-decoration: underline;
  }
  .wl-note a:hover {
    color: var(--ink);
  }
</style>

<script>
  // ─────────────────────────────────────────────────────────────────────────
  // Emails save to YOUR Google Sheet. One-time setup (~3 min) in WAITLIST_SETUP.md:
  //   create the Sheet → Extensions ▸ Apps Script → paste Code.gs →
  //   Deploy ▸ Web app ▸ Execute as: Me ▸ Who has access: Anyone → copy /exec URL.
  // Paste that URL here:
  // ─────────────────────────────────────────────────────────────────────────
  const WAITLIST_ENDPOINT =
    "https://script.google.com/macros/s/AKfycbzowwx0GkaxiHB0dIUfD2zenhuUvsvGtwKjObLuoSlA7_gM_2vdONMz6cIMcsWtVgYLDQ/exec";
  const isPlaceholder = WAITLIST_ENDPOINT.includes("PASTE_YOUR_DEPLOYMENT_ID");

  document.querySelectorAll<HTMLFormElement>(".waitlist-form").forEach((form) => {
    const wrap = form.closest(".waitlist");
    const stamp = wrap?.querySelector(".wl-stamp");
    const errorMsg = wrap?.querySelector(".wl-error");
    const btn = form.querySelector("button");
    const label = btn?.querySelector(".wl-label");
    const spinner = btn?.querySelector(".wl-spinner");
    const input = form.querySelector<HTMLInputElement>('input[type="email"]');
    const sourceEl = form.querySelector<HTMLInputElement>('input[name="source"]');
    const honeypot = form.querySelector<HTMLInputElement>('input[name="company"]');

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!input || !input.checkValidity()) {
        input?.reportValidity();
        return;
      }

      errorMsg?.setAttribute("hidden", "");
      label?.setAttribute("hidden", "");
      spinner?.removeAttribute("hidden");
      btn?.setAttribute("disabled", "true");

      const finish = (ok: boolean) => {
        spinner?.setAttribute("hidden", "");
        if (ok) {
          form.style.opacity = "0.5";
          form.style.pointerEvents = "none";
          stamp?.removeAttribute("hidden");
        } else {
          label?.removeAttribute("hidden");
          btn?.removeAttribute("disabled");
          errorMsg?.removeAttribute("hidden");
        }
      };

      // Honeypot tripped → almost certainly a bot. Fake success, skip the POST.
      if (honeypot && honeypot.value.trim() !== "") {
        finish(true);
        return;
      }

      // No endpoint configured yet → optimistic success so the demo works.
      if (isPlaceholder) {
        setTimeout(() => finish(true), 400);
        return;
      }

      try {
        // Form-encoded body = a "simple" CORS request (no preflight) — the
        // reliable way to POST to an Apps Script web app from the browser.
        const res = await fetch(WAITLIST_ENDPOINT, {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8" },
          body: new URLSearchParams({
            email: input.value,
            source: sourceEl?.value || "",
          }).toString(),
        });
        finish(res.ok);
      } catch {
        finish(false);
      }
    });
  });
</script>
