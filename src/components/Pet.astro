---
// Minnie herself — drawn once, reused everywhere.
//
// Both poses ship in the markup and CSS picks one from `data-pose`, so a script
// can switch her expression by flipping a single attribute (no DOM rebuild):
//   svg.dataset.pose = "think"
interface Props {
  pose?: "idle" | "think";
  size?: number; // rendered width in px; height follows the 140:178 ratio
  hop?: boolean;
  jitter?: boolean;
  id?: string;
}
const { pose = "idle", size = 112, hop = false, jitter = false, id } = Astro.props;
const height = Math.round((size * 178) / 140);
const anim = hop ? "hop 1.1s steps(4,end) infinite" : jitter ? "jitter 1.1s steps(2,end) infinite" : "none";
---

<span style={`width:${size}px; height:${height}px; display:block; animation:${anim};`}>
  <svg
    id={id}
    class="pet"
    data-pose={pose}
    viewBox="0 0 140 178"
    width="100%"
    height="100%"
    style="display:block; overflow:visible;"
    role="img"
    aria-label="Minnie the desktop pet"
  >
    <g stroke="#2b2118" stroke-width="5" stroke-linejoin="round" stroke-linecap="round" fill="#f7f2e6">
      <!-- feet -->
      <ellipse cx="50" cy="158" rx="17" ry="10" />
      <ellipse cx="90" cy="158" rx="17" ry="10" />

      <!-- arms — idle hangs both down, thinking raises the right one -->
      <g data-p="idle">
        <ellipse cx="24" cy="118" rx="12" ry="19" transform="rotate(-14 24 118)" />
        <ellipse cx="116" cy="118" rx="12" ry="19" transform="rotate(14 116 118)" />
      </g>
      <g data-p="think">
        <ellipse cx="24" cy="118" rx="12" ry="19" transform="rotate(-14 24 118)" />
        <ellipse class="pet__arm" cx="120" cy="86" rx="11" ry="19" transform="rotate(38 120 86)" />
      </g>

      <!-- body + belly -->
      <ellipse cx="70" cy="122" rx="42" ry="37" />
      <ellipse cx="70" cy="128" rx="23" ry="20" fill="#f0b83c" />

      <!-- ears + head. Each ear is its own group so it can twitch on its
           own timing — two ears moving in lockstep reads mechanical. -->
      <g class="pet__ear pet__ear--l">
        <circle cx="44" cy="40" r="17" />
        <circle cx="40" cy="34" r="7" fill="#f0b83c" stroke-width="0" />
      </g>
      <g class="pet__ear pet__ear--r">
        <circle cx="96" cy="40" r="17" />
        <circle cx="100" cy="34" r="7" fill="#f0b83c" stroke-width="0" />
      </g>
      <circle cx="70" cy="66" r="37" />

      <!-- cheeks -->
      <circle cx="46" cy="76" r="7" fill="#f0b83c" stroke-width="0" />
      <circle cx="94" cy="76" r="7" fill="#f0b83c" stroke-width="0" />

      <!-- eyes — round when idle, taller and lifted when thinking -->
      <g data-p="idle" class="pet__eyes" fill="#2b2118" stroke-width="0">
        <circle cx="57" cy="62" r="6" />
        <circle cx="83" cy="62" r="6" />
      </g>
      <g data-p="think" class="pet__eyes" fill="#2b2118" stroke-width="0">
        <ellipse cx="57" cy="58" rx="5" ry="7" />
        <ellipse cx="83" cy="58" rx="5" ry="7" />
      </g>

      <!-- mouth — a smile, or a small "o" while she works -->
      <g data-p="idle">
        <path d="M60 78 q10 10 20 0" fill="none" stroke-width="5" />
      </g>
      <g data-p="think">
        <ellipse cx="70" cy="80" rx="6" ry="7" fill="none" stroke-width="5" />
      </g>
    </g>
  </svg>
</span>

<style is:global>
  .pet[data-pose="idle"] [data-p="think"],
  .pet[data-pose="think"] [data-p="idle"] {
    display: none;
  }

  /* ── Life ──────────────────────────────────────────────────────────────
     What makes a character read as alive is not big movement, it is small
     movement that never quite repeats. The blink, the two ear twitches and
     the sway all run on different, deliberately non-multiple durations, so
     they drift out of phase and the loop is hard to spot. */
  .pet__eyes,
  .pet__ear,
  .pet__arm {
    transform-box: fill-box;
    transform-origin: center;
  }
  .pet__ear--l { transform-origin: 70% 90%; }
  .pet__ear--r { transform-origin: 30% 90%; }

  .pet__eyes { animation: petBlink 5.3s ease-in-out infinite; }
  .pet__ear--l { animation: petEarL 7.1s ease-in-out infinite; }
  .pet__ear--r { animation: petEarR 9.7s ease-in-out infinite; }
  .pet { animation: petSway 6.7s ease-in-out infinite; }

  /* The eyes shut for ~130ms out of 5.3s — any longer and she looks sleepy. */
  @keyframes petBlink {
    0%, 95.5%, 100% { transform: scaleY(1); }
    97%, 97.6% { transform: scaleY(0.06); }
  }
  @keyframes petEarL {
    0%, 86%, 100% { transform: rotate(0deg); }
    89% { transform: rotate(-8deg); }
    92% { transform: rotate(2deg); }
  }
  @keyframes petEarR {
    0%, 78%, 100% { transform: rotate(0deg); }
    81% { transform: rotate(7deg); }
    85% { transform: rotate(-2deg); }
  }
  @keyframes petSway {
    0%, 100% { transform: rotate(-1.1deg); }
    50% { transform: rotate(1.1deg); }
  }

  /* A short squash when she changes state, so switching feels like she
     reacted rather than like the page swapped an image. */
  .pet.is-pop { animation: petPop 0.42s cubic-bezier(0.34, 1.56, 0.64, 1); }
  @keyframes petPop {
    0% { transform: scale(1); }
    38% { transform: scale(1.09, 0.93); }
    100% { transform: scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .pet, .pet__eyes, .pet__ear, .pet__arm { animation: none !important; }
  }
</style>
