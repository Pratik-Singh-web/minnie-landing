---
const rows = [
  { cap: "Executes tasks locally on your Mac", a: "YES", b: "NO", c: "YES" },
  { cap: "Voice command + spoken consent", a: "YES", b: "NO", c: "NO" },
  { cap: "Ambient status you can glance at", a: "YES", b: "NO", c: "NO" },
  { cap: "Lives natively on your desktop", a: "YES", b: "NO", c: "NO" },
  { cap: "On-device privacy", a: "YES", b: "NO", c: "YES" },
  { cap: "Uses your own agent keys, no markup", a: "YES", b: "NO", c: "YES" },
];

// Yes/no use the semantic tokens so they stay legible on both grounds —
// the old literals were tuned for a cream table that dark mode no longer has.
const verdict = (v: string) => (v === "YES" ? "var(--green)" : "var(--red)");
---

<section class="sec sec--deep">
  <div class="wrap">
    <div class="sec-head reveal-slam" style="margin-bottom:40px;">
      <span class="eyebrow eyebrow--pink">Comparison</span>
      <h2 class="h2">Why Minnie?</h2>
    </div>

    <div class="cmp reveal-up">
      <div class="cmp__scroll">
        <table class="cmp__table">
          <thead>
            <tr>
              <th>Capability</th>
              <th class="cmp__mine">Minnie</th>
              <th>Web chatbot</th>
              <th>Bare CLI agent</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <td class="cmp__cap">{r.cap}</td>
                <td class="cmp__yes">{r.a}</td>
                <td style={`color:${verdict(r.b)};`}>{r.b}</td>
                <td style={`color:${verdict(r.c)};`}>{r.c}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<style>
  .cmp {
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: var(--sunk);
    box-shadow: 10px 10px 0 var(--yellow);
    overflow: hidden;
  }
  .cmp__scroll { overflow-x: auto; }

  .cmp__table {
    width: 100%;
    text-align: left;
    border-collapse: collapse;
    min-width: 660px;
    color: var(--ink);
  }
  .cmp__table thead tr {
    background: var(--band);
    color: var(--on-band);
  }
  .cmp__table th {
    padding: 18px;
    font-family: var(--font-display);
    font-size: 14.5px;
    font-weight: 800;
    text-transform: uppercase;
  }
  .cmp__mine { color: var(--on-band-dim); }

  .cmp__table tbody tr { border-top: 1px solid var(--line); }
  .cmp__table td {
    padding: 16px 18px;
    font-size: 16px;
    font-weight: 800;
  }
  .cmp__cap { font-weight: 700; }
  .cmp__yes {
    background: var(--yellow);
    color: var(--ink);
  }
</style>
