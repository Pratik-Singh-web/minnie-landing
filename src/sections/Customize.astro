---
import Pet from "../components/Pet.astro";

const species = [
  { id: "minnie", label: "Minnie", tint: "#ff5f9e" },
  { id: "panda", label: "Panda", tint: "#f4efe2" },
  { id: "raccoon", label: "Raccoon", tint: "#8ba393" },
  { id: "dog", label: "Dog", tint: "#ffd23f" },
];

const personas = [
  { id: "chill", label: "Chill + witty" },
  { id: "cheerful", label: "Cheerful + curious" },
  { id: "earnest", label: "Earnest helper" },
];

// persona → species → what she'd say
const quotes = {
  chill: {
    minnie: '"Oh, another error? Let me guess — typo on line 42 again?"',
    panda: '"Mmm. I was eating bamboo. Do I really have to run this compile?"',
    raccoon: '"I found some trash files in your build directory. Can I throw them out?"',
    dog: '"I dug up a missing export keyword! Look. Look. I fetched it."',
  },
  cheerful: {
    minnie: "\"Hello! Let's look at this file! Can I run pytest now? Please?!\"",
    panda: "\"Yay, code time! I'm ready to help you write tests!\"",
    raccoon: '"A new task! Oh, I love investigating import cycles!"',
    dog: "\"Bark! Let's play with the database schema! I'll go fetch the logs!\"",
  },
  earnest: {
    minnie: '"Ready to assist. I can audit the codebase or debug the current tests."',
    panda: '"Diagnostics running. Verifying structural integrity of the project."',
    raccoon: '"Refactoring plan compiled. Awaiting permission to commit adjustments."',
    dog: '"Test suite is failing. Proposing a verification sequence for the endpoints."',
  },
};
---

<section id="customize" class="sec">
  <div class="wrap custom__grid">
    <div class="reveal-l">
      <span class="eyebrow eyebrow--pink">Personalization</span>
      <h2 class="h2">She's your pet. Not a corporate assistant.</h2>
      <p class="lede">
        Pick a species, pick a temperament, give her a name. Change your mind on a Tuesday. She
        adapts to your vibe, not the other way round.
      </p>

      <div class="custom__controls">
        <div>
          <label class="custom__label mono" for="pet-name">01 / name her</label>
          <input id="pet-name" class="custom__name" value="Minnie" maxlength="12" autocomplete="off" />
        </div>

        <div>
          <span class="custom__label mono">02 / species</span>
          <div class="custom__opts" id="species-opts">
            {species.map((s, i) => (
              <button
                type="button"
                class={`opt mono${i === 0 ? " opt--on" : ""}`}
                data-species={s.id}
                data-tint={s.tint}
                data-label={s.label}
                aria-pressed={i === 0 ? "true" : "false"}
              >{s.label}</button>
            ))}
          </div>
        </div>

        <div>
          <span class="custom__label mono">03 / personality</span>
          <div class="custom__opts" id="persona-opts">
            {personas.map((p, i) => (
              <button
                type="button"
                class={`opt mono${i === 0 ? " opt--on" : ""}`}
                data-persona={p.id}
                aria-pressed={i === 0 ? "true" : "false"}
              >{p.label}</button>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="custom__right reveal-r">
      <div class="card custom__card">
        <div class="tile custom__preview" id="preview-tile">
          <Pet size={126} hop />
        </div>

        <div class="custom__plate">
          <div class="custom__plateTop">
            <span class="custom__petname" id="preview-name">Minnie</span>
            <span class="custom__badge mono" id="preview-species">Minnie</span>
          </div>
          <p class="custom__quote" id="preview-quote" set:html={quotes.chill.minnie} />
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ quotes }}>
  const nameInput = document.getElementById("pet-name");
  const nameOut = document.getElementById("preview-name");
  const speciesOut = document.getElementById("preview-species");
  const quoteOut = document.getElementById("preview-quote");
  const tile = document.getElementById("preview-tile");

  let species = "minnie";
  let persona = "chill";

  const paint = () => {
    if (quoteOut) quoteOut.textContent = quotes[persona][species];
  };

  nameInput?.addEventListener("input", () => {
    if (nameOut) nameOut.textContent = nameInput.value.trim() || "Minnie";
  });

  const wire = (containerId, attr, onPick) => {
    const container = document.getElementById(containerId);
    container?.querySelectorAll("button").forEach((btn) => {
      btn.addEventListener("click", () => {
        container.querySelectorAll("button").forEach((b) => {
          b.classList.remove("opt--on");
          b.setAttribute("aria-pressed", "false");
        });
        btn.classList.add("opt--on");
        btn.setAttribute("aria-pressed", "true");
        onPick(btn.dataset[attr], btn);
      });
    });
  };

  wire("species-opts", "species", (id, btn) => {
    species = id;
    if (tile) tile.style.background = btn.dataset.tint;
    if (speciesOut) speciesOut.textContent = btn.dataset.label;
    paint();
  });

  wire("persona-opts", "persona", (id) => {
    persona = id;
    paint();
  });
</script>

<style>
  .custom__grid {
    display: grid;
    gap: 48px;
    grid-template-columns: 1fr;
    align-items: center;
  }
  @media (min-width: 900px) {
    .custom__grid { grid-template-columns: 1.15fr 0.85fr; }
  }

  .custom__controls {
    margin-top: 30px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .custom__label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
    margin-bottom: 8px;
  }
  .custom__name {
    width: 100%;
    max-width: 24rem;
    padding: 13px 18px;
    font-size: 15px;
    font-weight: 700;
    background: var(--card);
    border: 3px solid var(--line);
    box-shadow: var(--sh-sm);
    color: var(--ink);
    outline: none;
  }

  .custom__opts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  /* Selected options sit *in* their shadow — pressed, not raised. */
  .opt {
    padding: 9px 16px;
    border: 3px solid var(--line);
    background: var(--card);
    color: var(--ink);
    font-size: 12px;
    cursor: pointer;
    box-shadow: var(--sh-sm);
    transition: none;
  }
  .opt:hover {
    background: var(--yellow);
    color: #101a12;
  }
  .opt--on,
  .opt--on:hover {
    background: var(--green);
    color: var(--on-green);
    font-weight: 700;
    box-shadow: 2px 2px 0 var(--line);
    transform: translate(2px, 2px);
  }

  .custom__right {
    display: flex;
    justify-content: center;
  }
  .custom__card {
    width: 100%;
    max-width: 23rem;
    box-shadow: var(--sh-lg);
    padding: 24px;
    transform: rotate(1.5deg);
  }
  .custom__preview {
    background: var(--pink);
    padding: 22px;
    box-shadow: var(--sh-sm);
  }

  .custom__plate {
    margin-top: 18px;
    border: 3px solid var(--line);
    background: var(--paper);
    padding: 16px;
  }
  .custom__plateTop {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }
  .custom__petname {
    font-family: Outfit, sans-serif;
    font-weight: 900;
    font-size: 17px;
    text-transform: uppercase;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .custom__badge {
    border: 2px solid var(--line);
    background: var(--yellow);
    color: #101a12;
    padding: 2px 8px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .custom__quote {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--ink-dim);
  }
</style>
