---
import Pet from "../components/Pet.astro";

const modes = [
  { title: "Allow once", body: "Approve just the next action, nothing more.", tint: "#ff5f9e" },
  { title: "For this session", body: "Auto-approve safe reads for the next hour.", tint: "#ffd23f" },
  { title: "Default mode", body: "Interactive review of edits plus command approvals.", tint: "#3fd07a" },
  { title: "Plan mode", body: "Research and draft suggestions, change nothing.", tint: "#f4efe2" },
];
---

<section class="sec">
  <div class="wrap trust__grid">
    <!-- The consent cloud, tilted like a sticker on the page -->
    <div class="trust__left reveal-l">
      <div class="card trust__card">
        <div class="trust__cloud">
          <div class="trust__cloudhead mono">
            <span class="trust__op">Edit</span>
            <span>mock_users.py</span>
          </div>
          <p class="trust__ask">I want to append the mock authentication payload. Ok?</p>
          <div class="trust__btns">
            <span class="trust__deny">Deny</span>
            <span class="trust__allow">Allow once</span>
          </div>
        </div>

        <div class="trust__petrow">
          <div class="tile trust__pet">
            <Pet size={100} pose="think" jitter />
          </div>
        </div>
      </div>
    </div>

    <div class="reveal-r">
      <span class="eyebrow">The consent layer</span>
      <h2 class="h2">Deny is a hug,<br />not a scold.</h2>
      <p class="lede">
        Every command, every file edit, every read of your workspace stops and asks. Say no and she
        just steps back, tail wagging. No half-finished edits, no wrecked config, no surprises in
        your git diff.
      </p>

      <div class="trust__modes">
        {modes.map((m) => (
          <div class="trust__mode">
            <span class="tile trust__check" style={`background:${m.tint};`}>✓</span>
            <div>
              <h4 class="trust__modeh">{m.title}</h4>
              <p class="trust__modep">{m.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .trust__grid {
    display: grid;
    gap: 48px;
    grid-template-columns: 1fr;
    align-items: center;
  }
  @media (min-width: 900px) {
    .trust__grid { grid-template-columns: 0.85fr 1.15fr; }
  }

  .trust__left {
    display: flex;
    justify-content: center;
  }
  .trust__card {
    width: 100%;
    max-width: 24rem;
    box-shadow: var(--sh-lg);
    padding: 24px;
    transform: rotate(-1.5deg);
  }

  .trust__cloud {
    border: 3px solid var(--line);
    background: var(--paper);
    padding: 18px;
    margin-bottom: 20px;
  }
  .trust__cloudhead {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
    font-size: 11px;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .trust__op {
    border: 2px solid var(--line);
    padding: 1px 6px;
    color: var(--ink);
  }
  .trust__ask {
    margin: 0 0 16px;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.45;
    color: var(--ink);
  }
  .trust__btns {
    display: flex;
    gap: 10px;
  }
  .trust__deny,
  .trust__allow {
    flex: 1;
    text-align: center;
    padding: 8px;
    border: 3px solid var(--line);
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
  }
  .trust__deny { color: var(--red); }
  .trust__allow {
    background: var(--green);
    color: var(--on-green);
  }

  .trust__petrow {
    display: flex;
    justify-content: center;
  }
  .trust__pet {
    width: 132px;
    height: 148px;
    background: var(--pink);
    box-shadow: var(--sh-sm);
    padding: 10px;
  }

  .trust__modes {
    display: grid;
    gap: 14px;
    margin-top: 30px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 620px) {
    .trust__modes { grid-template-columns: repeat(2, 1fr); }
  }

  .trust__mode {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    border: 3px solid var(--line);
    background: var(--card);
    padding: 14px;
    box-shadow: var(--sh-sm);
    transition: none;
  }
  .trust__mode:hover {
    background: var(--yellow);
    color: #101a12;
  }
  .trust__check {
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    font-weight: 900;
    font-size: 13px;
    color: #101a12;
  }
  .trust__modeh {
    margin: 0;
    font-family: Outfit, sans-serif;
    font-weight: 900;
    font-size: 15px;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }
  .trust__modep {
    margin: 4px 0 0;
    font-size: 13.5px;
    line-height: 1.5;
    color: inherit;
    opacity: 0.8;
  }
</style>
