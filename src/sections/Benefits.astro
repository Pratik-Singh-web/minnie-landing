---
// Six capabilities, each one something the shipping app actually does.
//
// MEDIA SLOT: each tile renders a tinted panel with its glyph. When real
// renders or app captures exist, drop them in as `image` and the panel becomes
// the frame — the copy, grid and order all stay.
const benefits = [
  { glyph: "🗣️", tint: "var(--pink)",
    title: "Talks back",
    body: "Say her name and talk. She answers out loud, on-device." },
  { glyph: "⚡", tint: "var(--yellow)",
    title: "Runs commands",
    body: "Real files, real shell, real test runs — on your Mac, not in a tab." },
  { glyph: "🧠", tint: "var(--accent-t)",
    title: "Works with your agent",
    body: "Claude Code today; Gemini, Codex and custom CLIs supported." },
  { glyph: "🔌", tint: "var(--sunk)",
    title: "Connects your tools",
    body: "Linear, Notion, Sentry, Jira, Asana and more — sign in once." },
  { glyph: "🌙", tint: "var(--pink)",
    title: "Stays out of the way",
    body: "Patrols, naps, and pauses herself when you go fullscreen." },
  { glyph: "📋", tint: "var(--sunk)",
    title: "Shows her work",
    body: "Every task she ran, every tool she called, in one list." },
];

const agents = ["Claude Code (full)", "Gemini CLI", "Codex", "Custom agents"];
---

<section id="features" class="sec">
  <div class="wrap">
    <div class="sec-head reveal-slam" style="margin-bottom:48px;">
      <span class="eyebrow eyebrow--pink">The difference</span>
      <h2 class="h2">Chatbots chat.<br />Minnie rolls up her sleeves.</h2>
      <p class="lede">
        She sits on top of the coding agent you already pay for and adds the three things it's
        missing: a body, a voice, and the manners to ask first.
      </p>
    </div>

    <div class="benefits__grid">
      {benefits.map((b) => (
        <div class="benefits__card reveal-up">
          <div class="benefits__media" style={`background:${b.tint};`}>
            <span class="benefits__glyph" aria-hidden="true">{b.glyph}</span>
          </div>
          <h3 class="benefits__h">{b.title}</h3>
          <p class="benefits__body">{b.body}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .benefits__grid { display: grid; grid-template-columns: 1fr; gap: 30px 26px; }
  @media (min-width: 680px) { .benefits__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .benefits__grid { grid-template-columns: repeat(3, 1fr); } }
  .benefits__card { display: flex; flex-direction: column; gap: 10px; }
  .benefits__media { aspect-ratio: 16 / 10; border-radius: var(--r-lg);
                     border: 1px solid var(--line); display: grid; place-items: center;
                     overflow: hidden; }
  .benefits__glyph { font-size: 40px; line-height: 1; }
  .benefits__h { margin: 4px 0 0; font-family: var(--font-display); font-size: 21px;
                 font-weight: 400; letter-spacing: -0.01em; }
  .benefits__body { margin: 0; font-size: 15px; line-height: 1.55; color: var(--ink-dim); }

  .benefits__grid {
    display: grid;
    gap: 26px;
    grid-template-columns: 1fr;
    margin-bottom: 56px;
  }
  @media (min-width: 900px) {
    .benefits__grid { grid-template-columns: repeat(3, 1fr); }
  }

  .benefits__card {
    padding: 26px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .benefits__icon {
    width: 56px;
    height: 56px;
    font-size: 26px;
    margin-bottom: 20px;
    box-shadow: var(--sh-sm);
  }
  .benefits__h {
    margin: 0 0 12px;
    font-family: var(--font-display);
    font-size: 23px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--ink);
  }
  .benefits__body {
    margin: 0;
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--ink-dim);
    text-wrap: pretty;
  }
  .benefits__chips {
    margin-top: 22px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  /* Bring-your-own-agent strip — always yellow, so its ink never inverts */
  .strip {
    border: 1px solid var(--line);
    background: var(--yellow);
    color: var(--ink);
    box-shadow: var(--sh);
    padding: 24px 26px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  @media (min-width: 860px) {
    .strip {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
  .strip__copy { max-width: 30rem; }
  .strip__h {
    margin: 0 0 6px;
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }
  .strip__p {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
  }
  .strip__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .strip__chip {
    border: 1px solid var(--line);
    background: transparent;
    padding: 7px 14px;
    font-size: 13px;
  }
  .strip__chip--on {
    background: var(--ink);
    color: var(--yellow);
    font-weight: 700;
  }
</style>
