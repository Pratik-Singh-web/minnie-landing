---
const benefits = [
  {
    icon: "⚡",
    tint: "#ffd23f",
    title: "She does the thing",
    body: "Minnie drives your CLI agent: real files, real shell commands, real test runs. A browser chatbot hands you a paragraph. Minnie hands you the patch.",
    chips: ["writes code", "runs tests"],
  },
  {
    icon: "🗣️",
    tint: "#ff5f9e",
    title: "She asks out loud",
    body: "Before touching a file or firing a command she says it: “I want to run pytest. Ok?” Answer with your voice — allow, deny, or let her off the leash.",
    chips: ["voice consent", "you decide"],
  },
  {
    icon: "🔒",
    tint: "#3fd07a",
    title: "She never phones home",
    body: "On-device Apple speech, your own local agent CLI, zero telemetry. Your codebase, your secrets and your auth stay on the Mac they started on.",
    chips: ["no cloud logs", "keychain auth"],
  },
];

const agents = ["Claude Code (full)", "Gemini CLI", "Codex", "Custom agents"];
---

<section id="features" class="sec">
  <div class="wrap">
    <div class="sec-head reveal-slam" style="margin-bottom:48px;">
      <span class="eyebrow eyebrow--pink">The difference</span>
      <h2 class="h2">Chatbots chat.<br />Minnie rolls up her sleeves.</h2>
      <p class="lede">
        She sits on top of the coding agent you already pay for and adds the three things it's
        missing: a body, a voice, and the manners to ask first.
      </p>
    </div>

    <div class="benefits__grid">
      {benefits.map((b) => (
        <div class="card card--lift benefits__card reveal-up">
          <div>
            <div class="tile benefits__icon jitter" style={`background:${b.tint};`}>{b.icon}</div>
            <h3 class="benefits__h">{b.title}</h3>
            <p class="benefits__body">{b.body}</p>
          </div>
          <div class="benefits__chips">
            {b.chips.map((c) => <span class="tag">{c}</span>)}
          </div>
        </div>
      ))}
    </div>

    <div class="strip reveal-up">
      <div class="strip__copy">
        <h4 class="strip__h">Bring your own agent + skills</h4>
        <p class="strip__p">
          She rides on the CLI agent you've already got logged in. Nothing to switch, nothing extra
          to pay.
        </p>
      </div>
      <div class="strip__chips mono">
        {agents.map((a, i) => (
          <span class={i === 0 ? "strip__chip strip__chip--on" : "strip__chip"}>{a}</span>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .benefits__grid {
    display: grid;
    gap: 26px;
    grid-template-columns: 1fr;
    margin-bottom: 56px;
  }
  @media (min-width: 900px) {
    .benefits__grid { grid-template-columns: repeat(3, 1fr); }
  }

  .benefits__card {
    padding: 26px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .benefits__icon {
    width: 56px;
    height: 56px;
    font-size: 26px;
    margin-bottom: 20px;
    box-shadow: var(--sh-sm);
  }
  .benefits__h {
    margin: 0 0 12px;
    font-family: Outfit, sans-serif;
    font-size: 23px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--ink);
  }
  .benefits__body {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-dim);
    text-wrap: pretty;
  }
  .benefits__chips {
    margin-top: 22px;
    padding-top: 16px;
    border-top: 3px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  /* Bring-your-own-agent strip — always yellow, so its ink never inverts */
  .strip {
    border: 3px solid var(--line);
    background: var(--yellow);
    color: #101a12;
    box-shadow: var(--sh);
    padding: 24px 26px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  @media (min-width: 860px) {
    .strip {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
  .strip__copy { max-width: 30rem; }
  .strip__h {
    margin: 0 0 6px;
    font-family: Outfit, sans-serif;
    font-size: 18px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }
  .strip__p {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
  }
  .strip__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .strip__chip {
    border: 3px solid #101a12;
    background: transparent;
    padding: 7px 14px;
    font-size: 12px;
  }
  .strip__chip--on {
    background: #101a12;
    color: var(--yellow);
    font-weight: 700;
  }
</style>
