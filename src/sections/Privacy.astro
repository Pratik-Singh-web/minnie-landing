---
const points = [
  {
    icon: "🎙️",
    tint: "#ff5f9e",
    title: "On-device voice",
    body: "Apple's local speech by default, or bring your own key. Your words are transcribed and spoken on your Mac.",
  },
  {
    icon: "💻",
    tint: "#3fd07a",
    title: "Your local agent CLI",
    body: "She drives the agent already installed on your machine. The thinking happens where your code lives.",
  },
  {
    icon: "🙈",
    tint: "#ffd23f",
    title: "No screen capture",
    body: "She never watches your screen or records your desktop. She sees only what you hand her.",
  },
  {
    icon: "📡",
    tint: "#ff5f9e",
    title: "Zero telemetry",
    body: "No analytics, no phone-home, no usage tracking. Nothing leaves unless a tool you approved sends it.",
  },
  {
    icon: "🔑",
    tint: "#3fd07a",
    title: "Secrets in the Keychain",
    body: "API keys and connector tokens live in your macOS Keychain — encrypted by the OS, never in plaintext.",
  },
  {
    icon: "🧾",
    tint: "#ffd23f",
    title: "Yours, on your terms",
    body: "Wipe her memory of you whenever you like. No account needed to run the app. Local-first, always.",
  },
];
---

<section id="privacy" class="sec sec--yellow">
  <div class="wrap">
    <div class="sec-head reveal-slam">
      <span class="eyebrow eyebrow--ink">Privacy by default</span>
      <h2 class="h2">Nothing leaves your Mac unless you ask.</h2>
      <p class="lede">
        Local-first all the way down. Your code, your conversations and your secrets stay where they
        already are — no exceptions, no fine print, no asterisk.
      </p>
    </div>

    <div class="privacy__grid">
      {points.map((p) => (
        <div class="card card--lift privacy__card reveal-up">
          <div class="tile privacy__icon" style={`background:${p.tint};`}>{p.icon}</div>
          <h3 class="privacy__h">{p.title}</h3>
          <p class="privacy__p">{p.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .privacy__grid {
    display: grid;
    gap: 22px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .privacy__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1000px) {
    .privacy__grid { grid-template-columns: repeat(3, 1fr); }
  }

  .privacy__card { padding: 22px; }
  .privacy__icon {
    width: 48px;
    height: 48px;
    font-size: 22px;
    margin-bottom: 14px;
  }
  .privacy__h {
    margin: 0 0 8px;
    font-family: Outfit, sans-serif;
    font-size: 18px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.015em;
  }
  .privacy__p {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    text-wrap: pretty;
  }
</style>
