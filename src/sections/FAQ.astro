---
// Keep these in sync with the FAQPage structured data in Layout.astro.
const faqs = [
  {
    q: "Does Minnie cost extra to run the AI?",
    a: "No. She drives the agent CLI you already use; it holds its own auth and does the reasoning. Zero extra AI cost.",
  },
  {
    q: "Which agents work?",
    a: "Claude Code today, with the full experience. Gemini CLI, Codex, Antigravity and custom command-line agents work too — they run more autonomously, since the voice-consent flow is Claude Code only for now.",
  },
  {
    q: "Is my code private?",
    a: "Yes. On-device voice by default, a local agent CLI, no screen capture, no telemetry. Secrets live in your macOS Keychain, and nothing leaves your Mac unless a tool you approved sends it.",
  },
  {
    q: "Do I need to set anything up?",
    a: "Install the agent CLI once (Claude Code, say) and log in. Minnie's onboarding walks you through the rest.",
  },
  {
    q: "Can I connect my own tools?",
    a: "Yes — a one-click MCP catalog (GitHub, Notion, Slack, Postgres, Figma…), custom servers, and native Sign in with Google for Gmail, Calendar and Chat.",
  },
  {
    q: "Does it work on Windows?",
    a: "macOS first. Windows is on the roadmap.",
  },
];
---

<section id="faq" class="wrap blk">
  <p class="eyebrow">The small print</p>
  <h2 class="h2">A few questions.</h2>
  <p class="quip faq__quip">go on, she's listening.</p>

  <div class="faq__list">
    {faqs.map((f, i) => (
      <div class="faq__item">
        <button type="button" class="faq__q" aria-expanded="false" aria-controls={`faq-a-${i}`}>
          <span>{f.q}</span>
          <span class="faq__sign" aria-hidden="true">＋</span>
        </button>
        <p class="faq__a" id={`faq-a-${i}`} hidden>{f.a}</p>
      </div>
    ))}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>(".faq__q").forEach((btn) => {
    btn.addEventListener("click", () => {
      const open = btn.getAttribute("aria-expanded") === "true";

      // One at a time — collapse the rest before opening this one.
      document.querySelectorAll<HTMLButtonElement>(".faq__q").forEach((other) => {
        other.setAttribute("aria-expanded", "false");
        
        document.getElementById(other.getAttribute("aria-controls")!)?.setAttribute("hidden", "");
      });

      if (!open) {
        btn.setAttribute("aria-expanded", "true");
        
        document.getElementById(btn.getAttribute("aria-controls")!)?.removeAttribute("hidden");
      }
    });
  });
</script>

<style>
  .faq__quip { margin: 14px 0 0; font-size: 17px; }
  .faq__list {
    margin-top: 40px;
    border-top: 1px solid var(--line);
  }
  .faq__item { border-bottom: 1px solid var(--line); }
  .faq__q {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 22px 0;
    background: none;
    border: 0;
    text-align: left;
    font: inherit;
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--ink);
    cursor: pointer;
  }
  .faq__q:hover { color: var(--accent); }
  .faq__sign {
    flex-shrink: 0;
    font-size: 20px;
    font-weight: 400;
    transition: transform 0.2s ease;
  }
  .faq__q[aria-expanded="true"] .faq__sign { transform: rotate(45deg); color: var(--accent); }
  .faq__a {
    margin: 0;
    padding: 0 0 22px;
    max-width: 44rem;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-dim);
  }
</style>
