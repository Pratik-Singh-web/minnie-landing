---
import Pet from "../components/Pet.astro";
---

<section class="final">
  <div class="final__inner">
    <div class="tile final__pet">
      <Pet size={100} hop />
    </div>

    <span class="eyebrow eyebrow--card">free open beta</span>

    <h2 class="final__h">
      Give your AI agent<br />
      <span class="slab final__slab">a body.</span>
    </h2>

    <p class="final__p">
      Free while she's in beta. Bring the coding agent you already pay for — Minnie gives it a
      body, a voice, and a place on your desktop.
    </p>

    <div class="final__form">
      <a href={`${import.meta.env.BASE_URL}download`} class="btn">Download the free beta →</a>
    </div>
  </div>
</section>

<style>
  .final {
    padding: 84px 0;
    border-bottom: 1px solid var(--line);
  }
  .final__inner {
    margin: 0 auto;
    max-width: 780px;
    padding: 0 24px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .final__pet {
    width: 132px;
    height: 152px;
    background: var(--pink);
    box-shadow: var(--sh);
    transform: rotate(-3deg);
    margin-bottom: 24px;
    padding: 10px;
  }

  .final__h {
    margin: 10px 0 0;
    font-family: var(--font-display);
    font-size: clamp(26px, 3.2vw, 36px);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .final__slab {
    background: transparent;
    color: var(--accent);
    transform: none;
    margin-top: 10px;
  }

  .final__p {
    margin: 26px 0 0;
    max-width: 32rem;
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-dim);
  }

  .final__form {
    margin-top: 28px;
    display: flex;
    justify-content: center;
    width: 100%;
  }
</style>
