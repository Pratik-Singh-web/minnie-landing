---
import Pet from "../components/Pet.astro";
import WaitlistForm from "../components/WaitlistForm.astro";
---

<section class="final">
  <div class="final__inner">
    <div class="tile final__pet">
      <Pet size={100} hop />
    </div>

    <span class="eyebrow eyebrow--card">founder price · first 500 devs</span>

    <h2 class="final__h">
      Give your AI agent<br />
      <span class="slab final__slab">a body.</span>
    </h2>

    <p class="final__p">
      Join the waitlist and lock in <strong>$19</strong> instead of $39 when she ships. One email on
      launch day, then silence.
    </p>

    <div class="final__form">
      <WaitlistForm source="final-cta" center note={false} />
    </div>
  </div>
</section>

<style>
  .final {
    padding: 84px 0;
    border-bottom: 3px solid var(--line);
  }
  .final__inner {
    margin: 0 auto;
    max-width: 780px;
    padding: 0 24px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .final__pet {
    width: 132px;
    height: 152px;
    background: var(--pink);
    box-shadow: var(--sh);
    transform: rotate(-3deg);
    margin-bottom: 24px;
    padding: 10px;
  }

  .final__h {
    margin: 18px 0 0;
    font-family: Outfit, sans-serif;
    font-size: clamp(40px, 6.4vw, 74px);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .final__slab {
    background: var(--green);
    color: var(--on-green);
    transform: rotate(2deg);
    margin-top: 10px;
  }

  .final__p {
    margin: 26px 0 0;
    max-width: 32rem;
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-dim);
  }

  .final__form {
    margin-top: 28px;
    display: flex;
    justify-content: center;
    width: 100%;
  }
</style>
