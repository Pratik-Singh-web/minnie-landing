---
const base = import.meta.env.BASE_URL;
---

<section class="wide panel final">
  <div class="final__top">
    <div>
      <p class="eyebrow final__eyebrow">Free for life</p>
      <h2 class="h2 final__h">Give your agent<br /><span class="slab">a body.</span></h2>
      <p class="final__p">Free forever. Bring the coding agent you already pay for.</p>
    </div>
    <a href={`${base}download`} class="btn">Download free for Mac</a>
  </div>

  <div class="final__bottom">
    <button type="button" class="final__pet" id="final-pet" aria-label="Pat her">
      <img src={`${base}minnie/still-curious.webp`} width="62" height="62" alt="" />
    </button>
    <span class="final__hint">Pat her</span>
    <span class="quip final__quip" id="final-quip">she'd like that.</span>
  </div>
</section>

<style>
  .final { margin-top: 120px; }
  .final__top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 28px;
  }
  .final__eyebrow { color: var(--on-band); }
  .final__h { color: var(--on-band); }
  .final__p {
    margin: 22px 0 0;
    font-size: 17px;
    color: var(--ink-dim);
  }

  .final__bottom {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 44px;
    font-size: 13px;
    color: var(--ink-soft);
  }
  .final__pet {
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border-radius: 999px;
    border: 0;
    background: var(--paper);
    cursor: pointer;
    transform: rotate(-6deg);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .final__pet:hover { transform: rotate(0) scale(1.06); }
  .final__pet.is-pat { transform: rotate(0) translateY(-10px) scale(1.1); }
  .final__quip { font-size: 15px; }
</style>

<script>
  const btn = document.getElementById("final-pet");
  const quip = document.getElementById("final-quip");
  const lines = ["she'd like that.", "again.", "ok, one more.", "you're very good at this."];
  let n = 0;
  btn?.addEventListener("click", () => {
    btn.classList.add("is-pat");
    setTimeout(() => btn.classList.remove("is-pat"), 300);
    n = (n + 1) % lines.length;
    if (quip) quip.textContent = lines[n];
  });
</script>
