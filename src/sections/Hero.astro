---
import PetStage from "../components/PetStage.astro";
---

<section class="hero">
  <div class="wrap hero__grid">
    <div>
      <h1 class="h1 hero__title">
        Give your AI agent<br />
        <span class="slab hero__slab">a body.</span>
      </h1>

      <p class="hero__lede">
        A macOS desktop pet that runs the AI coding agent you already use — talk to her, watch
        her work. Zero extra AI cost. Nothing leaves your Mac.
      </p>

      <!-- The waitlist is retired now there's a build to download.
           WaitlistForm.astro stays on disk for the v1 launch. -->
      <div id="waitlist" class="hero__form">
        <a href={`${import.meta.env.BASE_URL}download`} class="btn">Download the free beta →</a>
        <p class="hero__plat">
          Free while in beta · macOS 14+ · Apple Silicon only
        </p>
      </div>
    </div>

    <div class="hero__right">
      <PetStage picker={false} />
    </div>

  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 64px 0 72px;
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }
  .hero__grid {
    display: grid;
    gap: 48px;
    grid-template-columns: 1fr;
    align-items: center;
  }
  @media (min-width: 1000px) {
    .hero__grid { grid-template-columns: 1.15fr 0.85fr; }
  }

  .hero__stamp {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 14px;
    border: 1px solid var(--line);
    background: var(--yellow);
    color: var(--ink);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    box-shadow: var(--sh-sm);
  }
  .hero__dot {
    width: 8px;
    height: 8px;
    background: var(--ink);
    flex-shrink: 0;
  }

  .hero__title {
    font-size: clamp(42px, 5.9vw, 76px);
    line-height: 1.0;
    letter-spacing: -0.032em;
    text-wrap: nowrap;
  }
  .hero__slab { margin-top: 2px; }

  .hero__lede {
    margin: 22px 0 0;
    max-width: 30rem;
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-dim);
    text-wrap: pretty;
  }

  .hero__form {
    margin-top: 30px;
    width: 100%;
    max-width: 30rem;
  }

  .hero__right {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    padding: 7px 13px;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    background: var(--card);
    font-size: 12.5px;
    color: var(--ink-dim);
    text-wrap: pretty;
  }
  .hero__plat {
    margin-top: 10px;
    font-size: 14.5px;
    color: var(--ink-soft);
  }

  /* ── Process strip ──────────────────────────────────────────────────── */
  .steps {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 22px;
    margin: 44px 0 0;
    padding: 20px 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 700;
  }
  .steps li {
    display: inline-flex;
    align-items: center;
    gap: 9px;
  }
  .steps__n {
    font-size: 11px;
    font-weight: 400;
    color: var(--accent);
  }
  .steps__arrow {
    margin-left: 13px;
    color: var(--ink-soft);
    font-weight: 400;
  }
  @media (max-width: 720px) {
    .steps { font-size: 14.5px; gap: 8px 16px; }
    .steps__arrow { display: none; }
  }
</style>

<script>
  // ── She tracks the cursor, in 4px steps so it stays stop-motion ───────────
  const wrap = document.getElementById("hero-pet-wrap");
  if (wrap && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    window.addEventListener(
      "mousemove",
      (e) => {
        const r = wrap.getBoundingClientRect();
        const dx = (e.clientX - (r.left + r.width / 2)) / window.innerWidth;
        const dy = (e.clientY - (r.top + r.height / 2)) / window.innerHeight;
        const sx = Math.round((dx * 14) / 4) * 4;
        const sy = Math.round((dy * 10) / 4) * 4;
        wrap.style.transform = `translate(${sx}px,${sy}px)`;
      },
      { passive: true }
    );
  }

  // ── Hovering her makes her think ──────────────────────────────────────────
  const pet = document.getElementById("hero-pet");
  const status = document.getElementById("hero-status");
  wrap?.addEventListener("mouseenter", () => {
    if (pet) pet.dataset.pose = "think";
    if (status) status.textContent = "status: thinking";
  });
  wrap?.addEventListener("mouseleave", () => {
    if (pet) pet.dataset.pose = "idle";
    if (status) status.textContent = "status: idle";
  });
</script>
