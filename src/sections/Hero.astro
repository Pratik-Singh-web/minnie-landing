---
import Minnie from "../components/Minnie.astro";
const base = import.meta.env.BASE_URL;
---

<section class="hero wrap">
  <div class="hero__copy">
    <p class="hero__free"><span class="hero__dot" aria-hidden="true"></span>Free for life · No subscription · No card</p>
    <h1 class="h1 hero__title">
      Give your AI agent<br />
      <span class="slab">a body.</span>
    </h1>

    <p class="hero__lede">
      A free macOS desktop pet that runs the AI coding agent you already use — Claude Code,
      Gemini CLI or Codex. Talk to her, watch her work, and say yes before she touches anything.
    </p>

    <div class="hero__actions">
      <a href={`${base}download/`} class="btn">Download free for Mac</a>
      <a href={`${base}#features`} class="btn btn--card">See what she does</a>
    </div>
    <ul class="hero__facts">
      <li><strong>$0</strong> forever</li>
      <li><strong>$0</strong> extra AI cost</li>
      <li>macOS 14+ · Apple Silicon</li>
    </ul>
  </div>

  <div class="hero__art">
    <div class="hero__pet" id="hero-pet-wrap">
      <Minnie id="hero-pet" state="float" size={340} label="Minnie, a flame-shaped desktop pet, floating" />
    </div>
    <p class="quip hero__quip">
      You look busy. I'll wait.
      <span class="quip__sub">She means it. She has nothing else on.</span>
    </p>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
    padding-top: 48px;
    padding-bottom: 48px;
    min-height: 560px;
  }
  @media (min-width: 960px) {
    .hero { grid-template-columns: 1fr 1fr; }
  }

  /* The lifetime-free promise, above the headline: the first thing read. */
  .hero__free {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 22px;
    padding: 7px 14px;
    border-radius: 999px;
    background: var(--accent-t);
    color: var(--accent-ink);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .hero__dot {
    width: 8px;
    height: 8px;
    border-radius: 99px;
    background: var(--green);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--green) 25%, transparent);
  }

  .hero__title { margin: 0; }
  @media (min-width: 720px) {
    .hero__title { text-wrap: nowrap; }
  }

  .hero__lede {
    margin: 25px 0 0;
    max-width: 450px;
    font-size: 20px;
    line-height: 1.5;
    color: var(--ink-dim);
    text-wrap: pretty;
  }
  @media (max-width: 560px) { .hero__lede { font-size: 17px; } }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
    margin-top: 32px;
  }

  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin: 26px 0 0;
    padding: 0;
    list-style: none;
    font-size: 14.5px;
    color: var(--ink-dim);
  }
  .hero__facts strong { color: var(--ink); font-weight: 800; }

  .hero__art {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero__pet { transition: transform 0.25s ease; }
  /* Centred under her. The clip's square frame leaves ~18% empty below her
     tail, so the caption is pulled up into that gap rather than starting
     after the frame. Rotation pivots on the centre so it stays centred. */
  .hero__quip {
    align-self: center;
    margin: -48px 0 0;
    font-size: 18px;
    text-align: center;
    transform-origin: center;
  }
  .hero__quip .quip__sub { transform-origin: center; }
</style>

<script>
  // She leans toward the cursor, a few pixels at most.
  const wrap = document.getElementById("hero-pet-wrap");
  const pet = document.getElementById("hero-pet");
  if (wrap && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    addEventListener(
      "mousemove",
      (e) => {
        const r = wrap.getBoundingClientRect();
        const dx = (e.clientX - (r.left + r.width / 2)) / innerWidth;
        const dy = (e.clientY - (r.top + r.height / 2)) / innerHeight;
        wrap.style.transform = `translate(${dx * 16}px, ${dy * 10}px)`;
      },
      { passive: true }
    );
  }
  // Hovering her makes her happy.
  wrap?.addEventListener("mouseenter", () => pet && (pet.dataset.state = "happy"));
  wrap?.addEventListener("mouseleave", () => pet && (pet.dataset.state = "float"));
</script>
