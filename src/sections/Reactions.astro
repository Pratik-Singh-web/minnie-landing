---
import Pet from "../components/Pet.astro";

// Character state previewer.
//
// PLACEHOLDER ART. Every state below currently renders the same flat SVG pet
// with a different pose/animation — enough to show what each state *means*,
// not what it will look like. When the real 3D character lands, the only thing
// that changes is the `.stage__art` layer: give each state its own render or
// short loop and key it off `[data-state]`, exactly as the CSS already does.
// The state list, copy, control and keyboard handling all stay.
//
// The labels are Minnie's own states, not a generic Show/Wave/Celebrate set —
// each one is something she actually does, so the previewer doubles as an
// explanation of how she behaves.
const states = [
  { id: "idle",      label: "Idle",      pose: "idle",  status: "idle",      line: "Sitting in the corner of your screen, watching your cursor. She costs you nothing until you talk to her." },
  { id: "listening", label: "Listening", pose: "idle",  status: "listening", line: "You said her name. She's waiting for the rest of the sentence — on-device, nothing sent anywhere." },
  { id: "thinking",  label: "Thinking",  pose: "think", status: "thinking",  line: "Your agent is reasoning. She holds still so you can tell the difference between working and stuck." },
  { id: "working",   label: "Working",   pose: "think", status: "working",   line: "Running a real command on your Mac — editing a file, running the tests, reading the repo." },
  { id: "asking",    label: "Asking",    pose: "idle",  status: "asking",    line: "Before anything she can't take back, she stops and asks out loud. This is the one that matters." },
  { id: "hidden",    label: "Hidden",    pose: "idle",  status: "hidden",    line: "Tucked off-screen while you focus. One shortcut and she's back where she was." },
];
const initial = states[0];
---

<section class="sec" id="reactions">
  <div class="wrap">
    <div class="sec-head reveal-up">
      <span class="eyebrow">How she reacts</span>
      <h2 class="h2">Pick a state. Watch her change.</h2>
      <p class="lede">
        Six things Minnie does while you work. Tap through them — this is exactly how she behaves
        on your desktop.
      </p>
    </div>

    <div class="react reveal-up">
      <div class="stage" id="react-stage" data-state={initial.id}>
        <span class="stage__status mono" id="react-status">status: {initial.status}</span>

        <div class="stage__art">
          <Pet id="react-pet" pose={initial.pose} size={172} />
        </div>

        <!-- Only drawn in the listening state -->
        <span class="stage__bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>

        <!-- Only drawn in the asking state — her signature moment -->
        <div class="cloud" aria-hidden="true">
          <span class="cloud__q">I want to edit <code>mock_users.py</code>. Ok?</span>
          <span class="cloud__btns">
            <span class="cloud__btn cloud__btn--yes">Allow once</span>
            <span class="cloud__btn">Deny</span>
          </span>
        </div>

        <span class="stage__peek mono" aria-hidden="true">⌥Space to bring her back</span>
      </div>

      <div class="picker" role="group" aria-label="Minnie's states" id="react-picker">
        {states.map((s, i) => (
          <button
            type="button"
            class="picker__btn"
            data-go={s.id}
            data-pose={s.pose}
            data-status={s.status}
            aria-pressed={i === 0 ? "true" : "false"}
          >{s.label}</button>
        ))}
      </div>

      <p class="react__line" id="react-line">{initial.line}</p>
    </div>
  </div>
</section>

<style>
  .react {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }

  /* ── Stage ──────────────────────────────────────────────────────────── */
  .stage {
    position: relative;
    width: 100%;
    max-width: 620px;
    height: 290px;
    display: grid;
    place-items: center;
    background: var(--sunk);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
  }

  .stage__status {
    position: absolute;
    top: 12px;
    left: 12px;
    font-size: 11px;
    color: var(--ink-soft);
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    padding: 3px 9px;
  }

  .stage__art {
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.3s ease;
  }

  /* idle — a slow breath, so she reads as alive rather than parked */
  .stage[data-state="idle"] .stage__art { animation: breathe 3.4s ease-in-out infinite; }

  /* listening — leans in slightly, voice bars appear */
  .stage[data-state="listening"] .stage__art { transform: translateY(-4px) scale(1.03); }
  .stage__bars {
    position: absolute;
    bottom: 26px;
    display: none;
    gap: 4px;
    align-items: flex-end;
    height: 20px;
  }
  .stage[data-state="listening"] .stage__bars { display: flex; }
  .stage__bars i {
    width: 4px;
    height: 6px;
    background: var(--accent);
    border-radius: 2px;
    animation: bar 0.62s ease-in-out infinite;
  }
  .stage__bars i:nth-child(2) { animation-delay: 0.12s; }
  .stage__bars i:nth-child(3) { animation-delay: 0.24s; }
  .stage__bars i:nth-child(4) { animation-delay: 0.36s; }

  /* working — a small, steady shake: she is doing something, not waiting */
  .stage[data-state="working"] .stage__art { animation: busy 0.9s ease-in-out infinite; }

  /* asking — she steps aside to make room for the cloud */
  .stage[data-state="asking"] .stage__art { transform: translateX(-118px) scale(0.92); }
  .cloud {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 250px;
    margin-left: -26px;
    transform: translateY(-50%) scale(0.94);
    opacity: 0;
    pointer-events: none;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    box-shadow: var(--sh);
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: opacity 0.26s ease, transform 0.26s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .stage[data-state="asking"] .cloud {
    opacity: 1;
    transform: translateY(-50%) scale(1);
  }
  .cloud__q { font-size: 13px; line-height: 1.45; }
  .cloud__q code {
    font-family: var(--font-mono);
    font-size: 12px;
    background: var(--sunk);
    border-radius: 4px;
    padding: 1px 4px;
  }
  .cloud__btns { display: flex; gap: 7px; }
  .cloud__btn {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    padding: 5px 12px;
    border-radius: var(--r-pill);
    background: var(--sunk);
    border: 1px solid var(--line);
    color: var(--ink-dim);
  }
  /* Allow stays the semantic green — it is a verdict, not a brand colour. */
  .cloud__btn--yes {
    background: var(--green);
    color: var(--on-green);
    border-color: transparent;
  }

  /* hidden — she leaves, and tells you how to get her back */
  .stage[data-state="hidden"] .stage__art {
    transform: translateY(70px) scale(0.9);
    opacity: 0;
  }
  .stage__peek {
    position: absolute;
    font-size: 12px;
    color: var(--ink-soft);
    opacity: 0;
    transition: opacity 0.3s ease 0.12s;
  }
  .stage[data-state="hidden"] .stage__peek { opacity: 1; }

  @keyframes breathe {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-5px) scale(1.015); }
  }
  @keyframes busy {
    0%, 100% { transform: rotate(-1.4deg); }
    50% { transform: rotate(1.4deg) translateY(-2px); }
  }
  @keyframes bar {
    0%, 100% { height: 6px; }
    50% { height: 19px; }
  }

  /* ── Picker ─────────────────────────────────────────────────────────── */
  .picker {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px;
    background: var(--sunk);
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    padding: 4px;
  }
  .picker__btn {
    font-family: var(--font-display);
    font-size: 13.5px;
    font-weight: 700;
    color: var(--ink-dim);
    background: transparent;
    border: 0;
    border-radius: var(--r-pill);
    padding: 7px 15px;
    cursor: pointer;
    transition: background 0.16s ease, color 0.16s ease;
  }
  .picker__btn:hover { color: var(--ink); }
  .picker__btn[aria-pressed="true"] {
    background: var(--card);
    color: var(--accent);
    box-shadow: var(--sh-sm);
  }
  .picker__btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .react__line {
    margin: 0;
    max-width: 46rem;
    text-align: center;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--ink-dim);
    text-wrap: pretty;
    min-height: 2.6em;
  }

  /* Reduced motion still has to land on the right picture: kill the tween,
     keep the destination. A cloud left mid-transition at opacity 0 would make
     the asking state — the one that matters — look broken. */
  @media (prefers-reduced-motion: reduce) {
    .stage__art,
    .stage__bars i { animation: none !important; }
    .stage__art,
    .cloud,
    .stage__peek { transition: none !important; }
  }
</style>

<script>
  const LINES: Record<string, string> = {
    idle: "Sitting in the corner of your screen, watching your cursor. She costs you nothing until you talk to her.",
    listening: "You said her name. She's waiting for the rest of the sentence — on-device, nothing sent anywhere.",
    thinking: "Your agent is reasoning. She holds still so you can tell the difference between working and stuck.",
    working: "Running a real command on your Mac — editing a file, running the tests, reading the repo.",
    asking: "Before anything she can't take back, she stops and asks out loud. This is the one that matters.",
    hidden: "Tucked off-screen while you focus. One shortcut and she's back where she was.",
  };

  const stage = document.getElementById("react-stage");
  const picker = document.getElementById("react-picker");
  const statusEl = document.getElementById("react-status");
  const lineEl = document.getElementById("react-line");
  const pet = document.getElementById("react-pet");

  if (stage && picker && statusEl && lineEl && pet) {
    const buttons = [...picker.querySelectorAll<HTMLButtonElement>(".picker__btn")];

    const go = (btn: HTMLButtonElement) => {
      const id = btn.dataset.go!;
      stage.dataset.state = id;
      pet.setAttribute("data-pose", btn.dataset.pose || "idle");
      statusEl.textContent = `status: ${btn.dataset.status}`;
      lineEl.textContent = LINES[id] ?? "";
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
    };

    picker.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".picker__btn");
      if (btn) go(btn);
    });

    // Left/right arrows walk the group, the way a segmented control should.
    picker.addEventListener("keydown", (e) => {
      if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
      const i = buttons.findIndex((b) => b.getAttribute("aria-pressed") === "true");
      const next = buttons[(i + (e.key === "ArrowRight" ? 1 : buttons.length - 1)) % buttons.length];
      e.preventDefault();
      go(next);
      next.focus();
    });
  }
</script>
