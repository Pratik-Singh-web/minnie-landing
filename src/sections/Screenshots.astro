---
import { Picture } from "astro:assets";
import consent from "../assets/consent.png";
import thinking from "../assets/thinking.png";

// These are the only real photographs of the product on the whole site — every
// other "screenshot" is a CSS recreation in the page's own brutalist style.
// That is a deliberate split: the mocks carry the design, these carry the proof.
// astro:assets does the optimising (AVIF/WebP, explicit width+height so nothing
// shifts as they load), which is why they live in src/assets and not public/.
// idle.png is deliberately not used: its menu bar is a blurry render, and next
// to thinking.png it is the same picture with a different status pill. Re-shoot
// it at retina and the pair is worth restoring.
---

<section class="sec" id="screens">
  <div class="wrap">
    <div class="sec-head reveal-up">
      <span class="eyebrow eyebrow--pink">The real thing</span>
      <h2 class="h2">This is her, actually running.</h2>
      <p class="lede">
        Not a mockup. Minnie on a real Mac, asking before she runs a command she cannot take
        back.
      </p>
    </div>

    <div class="shots">
      <figure class="shot reveal-up">
        <div class="card shot__frame">
          <Picture
            src={consent}
            formats={["avif", "webp"]}
            widths={[420, 640, 900]}
            sizes="(min-width: 860px) 46vw, 100vw"
            alt="Minnie's consent cloud on macOS: she asks 'I want to delete the build folder. Ok?' before running rm -rf build/, offering Deny, Allow once and For session."
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption class="shot__cap">
          <code>rm -rf build/</code> — the kind of command you want to be asked about.
        </figcaption>
      </figure>

      <figure class="shot reveal-up">
        <div class="card shot__frame">
          <Picture
            src={thinking}
            formats={["avif", "webp"]}
            widths={[420, 640, 900]}
            sizes="(min-width: 860px) 46vw, 100vw"
            alt="Minnie sitting in the corner of a macOS desktop with a 'thinking' status pill while the coding agent works."
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption class="shot__cap">
          She stays out of the way — the agent works without you switching windows.
        </figcaption>
      </figure>
    </div>

  </div>
</section>

<style>
  .shot { margin: 0; }

  /* The screenshots are soft and glassy; the page is not. The hard border and
     offset shadow are what stop them reading as pasted-in foreign objects. */
  .shot__frame {
    overflow: hidden;
    line-height: 0;
  }
  .shot__frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .shot__cap {
    margin-top: 12px;
    font-size: 11px;
    text-transform: uppercase;
    color: var(--ink-soft);
    text-wrap: pretty;
  }
  .shot__cap code {
    font-family: inherit;
    color: var(--ink);
    background: var(--yellow);
    border: 1px solid var(--line);
    padding: 1px 5px;
    text-transform: none;
  }

  /* Side by side rather than stacked: the pair was 1790px tall on its own,
     22% of the whole page, for two images that say the same thing at half
     the size. */
  .shots {
    display: grid;
    grid-template-columns: 1fr;
    gap: 22px;
    align-items: start;
  }
  @media (min-width: 860px) {
    .shots { grid-template-columns: 1fr 1fr; }
  }
</style>
