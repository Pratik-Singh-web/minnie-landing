---
const s = `${import.meta.env.BASE_URL}minnie/`;
---

<!-- The ember band: one line, three stickers, one button. -->
<section class="wrap moods-wrap">
  <div class="moods">
    <div>
      <p class="eyebrow">Moods, too</p>
      <p class="moods__h">She reacts<br />while she works.</p>
    </div>

    <div class="moods__stickers" id="moods">
      <span class="moods__s" style="--r:-8deg"><img src={`${s}still-curious.webp`} width="70" height="70" alt="Minnie, curious" loading="lazy" decoding="async" /></span>
      <span class="moods__s" style="--r:4deg"><img src={`${s}still-content.webp`} width="70" height="70" alt="Minnie, content" loading="lazy" decoding="async" /></span>
      <span class="moods__s" style="--r:-3deg"><img src={`${s}still-cheeky.webp`} width="70" height="70" alt="Minnie, cheeky" loading="lazy" decoding="async" /></span>
    </div>

    <button type="button" class="moods__btn" id="moods-btn">Say hi <span aria-hidden="true">↓</span></button>
  </div>
</section>

<style>
  .moods-wrap { margin-top: 48px; }
  .moods {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 28px 34px;
    border-radius: 20px;
    background: var(--grad);
    color: var(--on-accent);
  }
  .moods .eyebrow { margin-bottom: 6px; }
  .moods__h {
    margin: 0;
    font-size: 22px;
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.045em;
  }

  .moods__stickers { display: flex; gap: 14px; }
  .moods__s {
    display: grid;
    place-items: center;
    width: 84px;
    height: 84px;
    border-radius: 999px;
    background: var(--paper);
    box-shadow: 0 3px 0 var(--accent-d);
    transform: rotate(var(--r));
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .moods__s:hover,
  .moods.is-hi .moods__s { transform: rotate(0deg) translateY(-8px) scale(1.06); }
  .moods.is-hi .moods__s:nth-child(2) { transition-delay: 0.06s; }
  .moods.is-hi .moods__s:nth-child(3) { transition-delay: 0.12s; }

  .moods__btn {
    font: inherit;
    font-size: 15px;
    font-weight: 700;
    padding: 11px 16px;
    border-radius: 10px;
    border: 1px solid rgba(46, 27, 18, 0.35);
    background: transparent;
    color: var(--on-accent);
    cursor: pointer;
  }
  .moods__btn:hover { border-color: var(--ink); }
</style>

<script>
  const band = document.querySelector<HTMLElement>(".moods");
  document.getElementById("moods-btn")?.addEventListener("click", () => {
    band?.classList.add("is-hi");
    setTimeout(() => band?.classList.remove("is-hi"), 700);
  });
</script>
