---
import Minnie from "../components/Minnie.astro";
const base = import.meta.env.BASE_URL;

// Her real animations. Each card plays one clip.
const moods = [
  { state: "happy", name: "Happy", kind: "Run went green", line: "Celebrates a passing build." },
  { state: "think", name: "Thinking", kind: "Agent reasoning", line: "Holds still so you can tell working from stuck." },
  { state: "float", name: "On the move", kind: "Coming to ask", line: "Floats over when she needs a yes." },
  { state: "sleep", name: "Sleeping", kind: "Hidden", line: "Dozes off while you focus." },
] as const;
---

<section id="customize" class="wide blk pets">
  <div class="pets__inner">
    <div class="head">
      <div>
        <p class="eyebrow">Meet Minnie</p>
        <h2 class="h2">One Minnie.<br />Lots of moods.</h2>
      </div>
      <div class="head__copy">
        <p>
          A little spark who lives on your desktop. Every mood means something, so you know what
          your agent is up to at a glance.
        </p>
        <a href={`${base}download/`} class="btn btn--card btn--sm">Meet her in the app</a>
      </div>
    </div>

    <ul class="pets__grid">
      {moods.map((m) => (
        <li class="pets__item">
          <div class="pets__art">
            <Minnie state={m.state} size={220} tile label={`Minnie, ${m.name.toLowerCase()}`} />
            <button type="button" class="pets__heart" aria-pressed="false" aria-label={`Favourite: ${m.name}`}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg>
            </button>
          </div>
          <div class="pets__meta">
            <strong>{m.name}</strong>
            <span>{m.kind}</span>
          </div>
          <p class="pets__line">{m.line}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .pets {
    border-top: 1px solid var(--line);
    padding-top: 36px;
  }
  .pets__inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 8px;
  }

  .pets__grid {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 28px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 900px) { .pets__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }

  .pets__art {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
  }
  .pets__art > :global(.minnie) { width: 100%; height: 100%; }

  .pets__heart {
    position: absolute;
    top: 0;
    right: 0;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 0;
    background: none;
    color: var(--ink-soft);
    cursor: pointer;
  }
  .pets__heart:hover { color: var(--ink); }
  .pets__heart[aria-pressed="true"] { color: var(--accent-ink); }
  .pets__heart[aria-pressed="true"] svg { fill: currentColor; }

  .pets__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    margin-top: 10px;
  }
  .pets__meta strong { font-size: 18px; letter-spacing: -0.03em; }
  .pets__meta span { font-size: 12px; color: var(--ink-soft); }
  .pets__line {
    margin: 4px 0 0;
    font-size: 14px;
    color: var(--ink-dim);
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>(".pets__heart").forEach((h) =>
    h.addEventListener("click", () => h.setAttribute("aria-pressed", String(h.getAttribute("aria-pressed") !== "true")))
  );
</script>
