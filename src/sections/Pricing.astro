---
// Pricing has to be ON the site and has to MATCH what Dodo is told: their
// verification is a comparison between the Product Information Form and the live
// page, and a mismatch is a documented cause of a form being held.
//
// This section existed but was never rendered, and its content predated the
// subscription decision (ADR-001) — it advertised a ONE-TIME $39 licence at a $19
// founder price. Rendering that would have been worse than showing no price at
// all: Dodo is configured for a $29/year subscription.
//
// The $39 strikethrough is gone on purpose. It was never a real price, and an
// invented "was" figure is a fake anchor — the kind of thing a compliance
// reviewer is specifically looking for.
const features = [
  "Bring your own AI account — we never bill you for AI",
  "Voice control, and your own tools connected over MCP",
  "Up to 3 Macs on one licence",
  "A year of updates",
];
---

<section id="pricing" class="sec">
  <div class="wrap">
    <div class="pricing__head reveal-slam">
      <span class="eyebrow">Pricing</span>
      <h2 class="h2">Free in open beta. Then $29 a year.</h2>
    </div>

    <div class="pricing__wrap reveal-up">
      <div class="card pricing__card">
        <span class="pricing__badge mono jitter">Free in beta</span>

        <h3 class="pricing__h">Minnie Pro</h3>
        <p class="pricing__limit mono">macOS · Apple Silicon</p>

        <div class="pricing__row">
          <span class="pricing__now">$29</span>
          <span class="pricing__unit mono">per year</span>
        </div>

        <div class="pricing__list">
          {features.map((f) => (
            <div class="pricing__item">
              <span class="tile pricing__tick">✓</span>
              <span>{f}</span>
            </div>
          ))}
        </div>

        <a href={`${import.meta.env.BASE_URL}download`} class="btn pricing__cta">
          Download free while she's in beta
        </a>
        <p class="pricing__note mono">
          1-day free trial, no card · 30-day refund · cancel any time
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .pricing__head {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto 40px;
  }
  .pricing__wrap {
    max-width: 28rem;
    margin: 0 auto;
  }
  .pricing__card {
    position: relative;
    box-shadow: 12px 12px 0 var(--pink);
    padding: 30px;
  }

  .pricing__badge {
    position: absolute;
    top: -16px;
    right: -10px;
    border: 3px solid var(--line);
    background: var(--yellow);
    color: #101a12;
    padding: 5px 12px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    box-shadow: var(--sh-sm);
    animation-duration: 1.6s;
  }

  .pricing__h {
    margin: 0 0 4px;
    font-family: Outfit, sans-serif;
    font-size: 26px;
    font-weight: 900;
    text-transform: uppercase;
    color: var(--ink);
  }
  .pricing__limit {
    margin: 0 0 22px;
    font-size: 11px;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .pricing__row {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 24px;
  }
  .pricing__now {
    font-family: Outfit, sans-serif;
    font-size: 66px;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  .pricing__was {
    font-size: 16px;
    color: var(--ink-soft);
    text-decoration: line-through;
  }
  .pricing__unit {
    font-size: 11px;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .pricing__list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 26px;
  }
  .pricing__item {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 14px;
    color: var(--ink);
  }
  .pricing__tick {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    background: var(--green);
    color: var(--on-green);
    font-size: 12px;
    font-weight: 900;
  }

  .pricing__cta {
    display: flex;
    width: 100%;
    padding: 16px;
    font-size: 15px;
  }
  .pricing__note {
    margin: 12px 0 0;
    text-align: center;
    font-size: 10.5px;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
</style>
