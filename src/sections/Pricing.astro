---
const features = [
  "Bring your own agent — no AI cost",
  "macOS app DMG (Windows on the roadmap)",
  "Lifetime licence and free v1 updates",
  "Local speech synthesis and key storage",
];
---

<section id="pricing" class="sec">
  <div class="wrap">
    <div class="pricing__head reveal-slam">
      <span class="eyebrow">Pricing</span>
      <h2 class="h2">Pay once. Keep her forever.</h2>
    </div>

    <div class="pricing__wrap reveal-up">
      <div class="card pricing__card">
        <span class="pricing__badge mono jitter">Founder offer</span>

        <h3 class="pricing__h">Minnie licence</h3>
        <p class="pricing__limit mono">first 500 developers only</p>

        <div class="pricing__row">
          <span class="pricing__now">$19</span>
          <span class="pricing__was">$39</span>
          <span class="pricing__unit mono">one-time</span>
        </div>

        <div class="pricing__list">
          {features.map((f) => (
            <div class="pricing__item">
              <span class="tile pricing__tick">✓</span>
              <span>{f}</span>
            </div>
          ))}
        </div>

        <a href="#waitlist" class="btn pricing__cta">Lock in founder price</a>
        <p class="pricing__note mono">30-day money-back after launch</p>
      </div>
    </div>
  </div>
</section>

<style>
  .pricing__head {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto 40px;
  }
  .pricing__wrap {
    max-width: 28rem;
    margin: 0 auto;
  }
  .pricing__card {
    position: relative;
    box-shadow: 12px 12px 0 var(--pink);
    padding: 30px;
  }

  .pricing__badge {
    position: absolute;
    top: -16px;
    right: -10px;
    border: 3px solid var(--line);
    background: var(--yellow);
    color: #101a12;
    padding: 5px 12px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    box-shadow: var(--sh-sm);
    animation-duration: 1.6s;
  }

  .pricing__h {
    margin: 0 0 4px;
    font-family: Outfit, sans-serif;
    font-size: 26px;
    font-weight: 900;
    text-transform: uppercase;
    color: var(--ink);
  }
  .pricing__limit {
    margin: 0 0 22px;
    font-size: 11px;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .pricing__row {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 24px;
  }
  .pricing__now {
    font-family: Outfit, sans-serif;
    font-size: 66px;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  .pricing__was {
    font-size: 16px;
    color: var(--ink-soft);
    text-decoration: line-through;
  }
  .pricing__unit {
    font-size: 11px;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .pricing__list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 26px;
  }
  .pricing__item {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 14px;
    color: var(--ink);
  }
  .pricing__tick {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    background: var(--green);
    color: var(--on-green);
    font-size: 12px;
    font-weight: 900;
  }

  .pricing__cta {
    display: flex;
    width: 100%;
    padding: 16px;
    font-size: 15px;
  }
  .pricing__note {
    margin: 12px 0 0;
    text-align: center;
    font-size: 10.5px;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
</style>
