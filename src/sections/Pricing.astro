---
// Pricing has to be ON the site and has to MATCH what Dodo is told: their
// verification is a comparison between the Product Information Form and the live
// page, and a mismatch is a documented cause of a form being held.
//
// This section existed but was never rendered, and its content predated the
// subscription decision (ADR-001) — it advertised a ONE-TIME $39 licence at a $19
// founder price. Rendering that would have been worse than showing no price at
// all: Dodo is configured for a $29/year subscription.
//
// The $39 strikethrough is gone on purpose. It was never a real price, and an
// invented "was" figure is a fake anchor — the kind of thing a compliance
// reviewer is specifically looking for.
//
// REWRITTEN 2026-09-26 (C3). The model changed on 2026-09-09: the core is free
// permanently and what is sold is a CHARACTER, one-time. The $29/year above was
// therefore advertising a product that no longer exists — the same mismatch this
// file's own comment warns about, pointing the other way.
//
// ⚠️ Characters are named but NOT priced, because none exists yet. Naming a
// figure for something unbuilt is exactly the invented number the note above
// refuses. Add the price when the first character ships (C6/C7) — and tell Dodo
// at the same time.
const features = [
  "Everything she does — voice, wake word, real tasks on your Mac",
  "Bring your own AI account — we never bill you for AI",
  "Your own tools connected over MCP",
  "No trial, no subscription, no card",
];

// C6b — what is on sale comes from /catalogue, never from a constant here.
// Empty is the normal state today and renders nothing.
import { fetchCatalogue, priceText } from "../catalogue";
const onSale = await fetchCatalogue();
---

<section id="pricing" class="sec">
  <div class="wrap">
    <div class="pricing__head reveal-slam">
      <span class="eyebrow">Pricing</span>
      <h2 class="h2">Free. Forever.</h2>
    </div>

    <div class="pricing__wrap reveal-up">
      <div class="card pricing__card">
        <span class="pricing__badge jitter">Free</span>

        <h3 class="pricing__h">Minnie</h3>
        <p class="pricing__limit">macOS · Apple Silicon</p>

        <div class="pricing__row">
          <span class="pricing__now">$0</span>
          <span class="pricing__unit">forever</span>
        </div>

        <div class="pricing__list">
          {features.map((f) => (
            <div class="pricing__item">
              <span class="tile pricing__tick">✓</span>
              <span>{f}</span>
            </div>
          ))}
        </div>

        <a href={`${import.meta.env.BASE_URL}download/`} class="btn pricing__cta">
          Download Minnie
        </a>
        {onSale.length === 0 ? (
          <p class="pricing__note">
            Later: extra characters — a look, moves and a voice of their own —
            will be one-time purchases. Everything above stays free.
          </p>
        ) : (
          <div class="pricing__chars">
            <p class="pricing__note">
              Optional extra characters — a look, moves and a voice of their own.
              One-time, never a subscription. Everything above stays free.
            </p>
            <ul class="pricing__charlist">
              {onSale.map((c) => (
                <li>
                  <strong>{c.name}</strong>
                  {c.blurb && <span class="pricing__charblurb"> — {c.blurb}</span>}
                  {/* No price means not on sale yet. It renders as nothing,
                      never as "free" and never as a zero. */}
                  {priceText(c) && <span class="pricing__charprice">{priceText(c)}</span>}
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .pricing__head {
    text-align: center;
    max-width: 40rem;
    margin: 0 auto 40px;
  }
  .pricing__wrap {
    max-width: 28rem;
    margin: 0 auto;
  }
  .pricing__card {
    position: relative;
    box-shadow: none;
    padding: 30px;
  }

  .pricing__badge {
    position: absolute;
    top: -16px;
    right: -10px;
    border: 1px solid var(--line);
    background: var(--yellow);
    color: var(--ink);
    padding: 5px 12px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    box-shadow: var(--sh-sm);
    animation-duration: 1.6s;
  }

  .pricing__h {
    margin: 0 0 4px;
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 700;
    color: var(--ink);
    letter-spacing: -0.035em;
  }
  .pricing__limit {
    margin: 0 0 22px;
    font-size: 11px;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .pricing__row {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 24px;
  }
  .pricing__now {
    font-family: var(--font-display);
    font-size: 66px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  .pricing__was {
    font-size: 16.5px;
    color: var(--ink-soft);
    text-decoration: line-through;
  }
  .pricing__unit {
    font-size: 11px;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .pricing__list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 26px;
  }
  .pricing__item {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 16px;
    color: var(--ink);
  }
  .pricing__tick {
    flex-shrink: 0;
    width: 21px;
    height: 21px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-size: 12px;
    font-weight: 800;
  }

  .pricing__cta {
    display: flex;
    width: 100%;
    padding: 16px;
    font-size: 16.5px;
  }
  /* Sentence case, not the old uppercase micro-type: this is now a sentence
     about what will cost money later, and uppercase at 10.5px is unreadable
     past about six words. */
  .pricing__charlist {
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .pricing__charlist li {
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-size: 0.95rem;
  }
  .pricing__charblurb { color: var(--ink-soft); flex: 1; }
  .pricing__charprice { font-weight: 700; white-space: nowrap; }

  .pricing__note {
    margin: 14px 0 0;
    text-align: center;
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--ink-soft);
  }
</style>
